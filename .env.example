# Copia este archivo a .env y completa los valores.  (.env está gitignoreado)

# ── Directus + Postgres (docker-compose) ──────────────────────────────
DB_USER=directus
DB_PASSWORD=cambia-esta-clave
DB_DATABASE=villajuan
DIRECTUS_SECRET=genera-un-hex-largo   # node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DIRECTUS_ADMIN_EMAIL=admin@villa-juan.com
DIRECTUS_ADMIN_PASSWORD=cambia-esta-clave

# ── Astro → Directus (build-time) ─────────────────────────────────────
# Si DIRECTUS_URL no está seteada o Directus no responde, el sitio usa el
# contenido semilla local (src/lib/blog.ts) y compila igual.
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=token-de-lectura   # lo crea cms/bootstrap.mjs y lo imprime
