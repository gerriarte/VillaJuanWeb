<style>
  /* Banda "Sabor de fuego": el gradiente negro→rojo→verde vive en un ::before cuya
     opacidad revela el color con el scroll (--fire, la maneja el JS de abajo, sincronizada
     con el encendido del barril). Fallback 1 = color estático (sin JS o con reduce-motion). */
  .fire-band::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: linear-gradient(
      180deg,
      transparent 0%,
      #0d0605 14%,
      #0d0605 30%,
      #5c0f06 48%,
      #a31d0b 68%,
      #a31d0b 90%,
      transparent 100%
    );
    opacity: var(--fire, 1);
    /* Amortigua el cambio frame-a-frame del scroll → reveal fluido, no a saltos. */
    transition: opacity 0.7s ease-out;
    will-change: opacity;
  }

  /* Barril encendido: misma amortiguación para que la ignición sea paulatina, no a saltos. */
  .barril-on {
    transition: opacity 0.7s ease-out;
    will-change: opacity;
  }
</style>

<script>
  // Enciende el barril ("on") gradualmente según el scroll. Respeta reduce-motion.
  // El mismo progreso `p` revela el color de la banda "Sabor de fuego" (var --fire).
  const on = document.querySelector<HTMLElement>('.barril-on');
  const fireBand = document.querySelector<HTMLElement>('.fire-band');
  if (on && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const sec = (on.closest('section') as HTMLElement) ?? (on.parentElement as HTMLElement);
    on.style.opacity = '0';
    fireBand?.style.setProperty('--fire', '0');
    const update = () => {
      const r = sec.getBoundingClientRect();
      const vh = window.innerHeight;
      // La ignición ARRANCA cuando la sección se ve completa (bottom llega al viewport)
      // y termina cuando la sección llega arriba. Así el cambio ocurre a la vista.
      // Barril: ignición PAULATINA. Arranca cuando la sección asoma por abajo (r.top≈vh)
      // y llega a "on" pleno cuando ya está bien a la vista (r.top≈35% vh), MUCHO antes
      // de pasarla. smoothstep + transición CSS = encendido gradual, sin saltos.
      const bRaw = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.65)));
      const bp = bRaw * bRaw * (3 - 2 * bRaw);
      on.style.opacity = bp.toFixed(3);
      // Color de la banda: reveal más sutil aún → arranca al asomar y se reparte sobre
      // un rango ancho (~1.4 viewport), suavizado con smoothstep.
      const raw = Math.min(1, Math.max(0, (vh - r.top) / (vh * 1.4)));
      const eased = raw * raw * (3 - 2 * raw);
      fireBand?.style.setProperty('--fire', eased.toFixed(3));
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }
</script>

<script>
  // Galería: carrusel "coverflow" con autoplay. Cada foto rota por 3 posiciones
  // (centro / derecha / izquierda). Flechas + dots + swipe + clic en un lateral.
  // Pausa en hover/focus. Respeta prefers-reduced-motion (invariante #4).
  const gallery = document.getElementById('gallery');
  if (gallery) {
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('.gal-slide'));
    const n = slides.length;
    const dots = Array.from(document.querySelectorAll<HTMLElement>('[data-gal-dot]'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const POS: Record<string, { t: string; z: string; o: string; f: string }> = {
      center: { t: 'translate(-50%,-50%) scale(1)', z: '30', o: '1', f: 'none' },
      right: { t: 'translate(-6%,-50%) scale(0.82) rotateY(-18deg)', z: '20', o: '0.78', f: 'brightness(0.82)' },
      left: { t: 'translate(-94%,-50%) scale(0.82) rotateY(18deg)', z: '20', o: '0.78', f: 'brightness(0.82)' },
      hidden: { t: 'translate(-50%,-50%) scale(0.6)', z: '0', o: '0', f: 'none' },
    };
    const posFor = (rel: number) =>
      rel === 0 ? 'center' : rel === 1 ? 'right' : rel === n - 1 ? 'left' : 'hidden';

    let idx = 0;
    const render = () => {
      slides.forEach((el, i) => {
        const p = POS[posFor((i - idx + n) % n)];
        el.style.transform = p.t;
        el.style.zIndex = p.z;
        el.style.opacity = p.o;
        el.style.filter = p.f;
        el.setAttribute('aria-hidden', p.o === '0' ? 'true' : 'false');
      });
      dots.forEach((d, j) => d.setAttribute('aria-current', j === idx ? 'true' : 'false'));
    };
    const goTo = (i: number) => { idx = (i + n) % n; render(); };

    dots.forEach((d, i) => d.addEventListener('click', () => { goTo(i); restart(); }));
    slides.forEach((el, i) => el.addEventListener('click', () => { if (i !== idx) { goTo(i); restart(); } }));
    const prev = document.querySelector<HTMLElement>('[data-gal-prev]');
    const next = document.querySelector<HTMLElement>('[data-gal-next]');
    [prev, next].forEach((b) => b?.setAttribute('data-on', ''));
    prev?.addEventListener('click', () => { goTo(idx - 1); restart(); });
    next?.addEventListener('click', () => { goTo(idx + 1); restart(); });

    // Swipe táctil
    let x0: number | null = null;
    gallery.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
    gallery.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 40) { goTo(idx + (dx < 0 ? 1 : -1)); restart(); }
      x0 = null;
    });

    // Autoplay (pausa en hover/focus; nada si reduce-motion)
    let timer: number | undefined;
    const stop = () => { if (timer) window.clearInterval(timer); };
    const start = () => { if (reduce) return; stop(); timer = window.setInterval(() => goTo(idx + 1), 3500); };
    const restart = () => { stop(); start(); };
    gallery.addEventListener('pointerenter', stop);
    gallery.addEventListener('pointerleave', start);
    gallery.addEventListener('focusin', stop);
    gallery.addEventListener('focusout', start);

    render();
    start();
  }
</script>

<script>
  // Villa Datos: entrada animada de los círculos + conteo de los números al entrar en vista.
  const dl = document.getElementById('villa-datos');
  if (dl) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fmt = (n: number) => '+' + n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    const circles = Array.from(dl.querySelectorAll<HTMLElement>('.stat-circle'));
    const counters = Array.from(dl.querySelectorAll<HTMLElement>('[data-count]'));
    dl.setAttribute('data-anim', '');

    const runCount = (el: HTMLElement) => {
      const target = Number(el.dataset.count || '0');
      if (reduce) {
        el.textContent = fmt(target);
        return;
      }
      const dur = 1400;
      const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(Math.round(target * eased));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            circles.forEach((c) => c.classList.add('is-in'));
            counters.forEach(runCount);
            obs.disconnect();
          }
        });
      },
      { threshold: 0.3 },
    );
    io.observe(dl);
  }
</script>
