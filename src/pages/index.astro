---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import HeroCarousel from '../components/sections/HeroCarousel.astro';
import LeafDivider from '../components/layout/LeafDivider.astro';
import Faq from '../components/sections/Faq.astro';
import NotifyDialog from '../components/ui/NotifyDialog.astro';
import VideoEmbed from '../components/sections/VideoEmbed.astro';
import SombreroTurntable from '../components/ui/SombreroTurntable.astro';
import CmsImage from '../components/ui/CmsImage.astro';
import { getGallery, type Photo } from '../lib/content';
import { visit, wa, social } from '../lib/site';
import { planPdfs, menuPdf } from '../lib/pdfs';
import fuenteCaballos from '../assets/images/home/fuente_caballos.jpg';
import horseCronicas from '../assets/images/home/horse_cronicas.png';
import tituloCronicas from '../assets/images/home/Titulo_cronicas.png';
import postCoaching from '../assets/images/home/hero_home_empresariales.jpg';
import postBarril from '../assets/images/home/hero_home_restaurante.jpg';
import horseImg from '../assets/images/home/bienvenida_horse.svg';
import globoImg from '../assets/images/home/bienvenida_globo.svg';
import expBanner from '../assets/images/home/ecogranja_experiencia_transformadora.svg';
import videoPoster from '../assets/images/home/video_comercial_poster.jpg';
import ramaImg from '../assets/images/home/rama_oferta_tight.webp';
import celebracionesOferta from '../assets/images/home/celebraciones_oferta.svg';
import empresasOferta from '../assets/images/home/empresas_oferta.svg';
import restauranteOferta from '../assets/images/home/restaurante_oferta.svg';
import blogOferta from '../assets/images/home/blog_ofertas.svg';
import barrilOff from '../assets/images/home/barril_off.svg';
import barrilOn from '../assets/images/home/barrill_on.svg';
import menuJeep from '../assets/images/home/menu_jeep.svg';
import tituloVillaDatos from '../assets/images/home/Titulo-Villa-Datos.svg';
import horseDatos from '../assets/images/home/horse_datos.svg';
import selfieAnimales from '../assets/images/home/selfie_con_animales.png';
import contactanos from '../assets/images/home/contactanos.png';
import villaPlanesTitulo from '../assets/images/home/villa-planes-titulo.png';
import car01 from '../assets/images/home/carrusel/01-carrusel.jpg';
import car02 from '../assets/images/home/carrusel/02-carrusel.jpg';
import car03 from '../assets/images/home/carrusel/03-carrusel.jpg';
import car04 from '../assets/images/home/carrusel/04-carrusel.jpg';
import car05 from '../assets/images/home/carrusel/05-naturaleza.jpg';
import car06 from '../assets/images/home/carrusel/06-planes-familiares.jpg';
import car07 from '../assets/images/home/carrusel/07-planes-familiares.jpg';
import car08 from '../assets/images/home/carrusel/08-planes-familiares.jpg';
import car09 from '../assets/images/home/carrusel/09-planes-familiares.jpg';
import car10 from '../assets/images/home/carrusel/10-planes-familiares.jpg';
import car11 from '../assets/images/home/carrusel/11-restaurante.jpg';
import car12 from '../assets/images/home/carrusel/12-restaurante.jpg';
import car13 from '../assets/images/home/carrusel/13-granja.jpg';

// Composición sobre la rama: Empresas ENCIMA; Pasadías, Celebraciones y Blog DEBAJO.
// `pos` = posición absoluta (desktop). Las clases se escriben literales para que Tailwind las genere.
const ofertaEmpresas = { img: empresasOferta, href: '/empresas', label: 'Empresas', w: 459, h: 535 };
const ofertasAbajo = [
  { img: restauranteOferta, href: '/villa-planes', label: 'Pasadías', w: 569, h: 525, pos: 'left-[18%] top-[48%]' },
  { img: celebracionesOferta, href: '/celebraciones', label: 'Celebraciones', w: 524, h: 581, pos: 'left-[40%] top-[52%]' },
  { img: blogOferta, href: '/blog', label: 'Blog', w: 449, h: 577, pos: 'left-[62%] top-[48%]' },
];
const ofertasMobile = [ofertaEmpresas, ...ofertasAbajo];

const stats = [
  { n: 1000, label: 'Eventos corporativos' },
  { n: 5000, label: 'Árboles sembrados' },
  { n: 100, label: 'Animales por conocer' },
  { n: 20000, label: 'Niños felices' },
  { n: 5000, label: 'Familias sonrientes' },
];
// Formato con separador de miles "." (manual, sin depender del ICU del build).
const fmt = (n: number): string => '+' + n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');

// Crónicas de la Tierra — posts destacados del blog en el home.
// href apunta al slug real del post en el blog (posts en Directus).
const cronicas = [
  {
    img: postCoaching,
    alt: 'Equipo corporativo celebrando en Villa Juan',
    title: 'Los Beneficios del Coaching Equino para Ejecutivos',
    excerpt: 'Descubre insights únicos sobre coaching desde Villa Juan.',
    href: '/blog/los-beneficios-del-coaching-equino-para-ejecutivos',
  },
  {
    img: postBarril,
    alt: 'Zona de asados al barril en Villa Juan',
    title: 'Secretos de la Cocción al Barril: Técnica Artesanal',
    excerpt:
      'Descubre insights únicos sobre gastronomía desde Villa Juan, experiencias auténticas y consejos prácticos para el crecimiento personal.',
    href: '/blog/secretos-de-la-coccion-al-barril-tecnica-artesanal-y-sabor-campestre',
  },
];

// Villa Planes en el home: botones-píldora con degradé por plan. Cada uno lleva a la página
// del plan, donde el PDF se ve embebido con header y footer (igual que en /villa-planes).
// Orden del home: del plan más completo al más simple (inverso al de /villa-planes).
const planesHome = [...planPdfs].reverse();

// "¿Cómo llegar desde Bogotá?" — 3 opciones de transporte con chip informativo/CTA.
const llegar: {
  title: string;
  body: string;
  pill: string;
  pillHref?: string;
}[] = [
  {
    title: 'Carro',
    body: 'Búscanos en Waze o Google Maps como Ecogranja Villa Juan.',
    pill: '45 minutos aprox.',
    pillHref: visit.maps,
  },
  {
    title: 'Transporte público',
    body: 'Portal 80 o Portal Norte → bus intermunicipal hasta el pueblo de Tenjo → taxi hasta Villa Juan.',
    pill: '1 hora 15 min aprox.',
  },
  {
    title: 'Transporte privado',
    body: 'Organizamos transporte grupal para tu pasadía o evento, sin complicaciones.',
    pill: 'Consultar disponibilidad',
    pillHref: wa('Quiero información del transporte a Villa Juan'),
  },
];

// Galería — carrusel "coverflow": las fotos rotan por 3 posiciones (centro al frente +
// laterales detrás, como el mockup). Estilos base (también sirven de fallback sin JS).
// Editable en Directus: colección `gallery`, section `home-galeria`. Esta lista es la
// semilla (lo que se ve si el CMS está vacío o no responde).
const galeriaSeed: Photo[] = [
  { image: { kind: 'local', asset: car05, alt: 'Vista panorámica de las zonas verdes de la Ecogranja Villa Juan en Tenjo, con montañas de fondo' } },
  { image: { kind: 'local', asset: car08, alt: 'Visitante riendo junto a una llama en la Ecogranja Villa Juan' } },
  { image: { kind: 'local', asset: car02, alt: 'El equipo de la Ecogranja Villa Juan celebrando el Granja Fest junto al jeep Willys' } },
  { image: { kind: 'local', asset: car06, alt: 'Familia disfrutando un día de campo con sus mascotas en la Ecogranja Villa Juan' } },
  { image: { kind: 'local', asset: car09, alt: 'Visitante disfrutando un paseo a caballo entre las carpas de camping de Villa Juan' } },
  { image: { kind: 'local', asset: car07, alt: 'Visitante abrazando a un burro en las praderas de la Ecogranja Villa Juan' } },
  { image: { kind: 'local', asset: car11, alt: 'Caballos ensillados listos para la cabalgata en la Ecogranja Villa Juan' } },
  { image: { kind: 'local', asset: car01, alt: 'Mesa y bancas campestres bajo un cenador circular en las zonas verdes de Villa Juan' } },
  { image: { kind: 'local', asset: car04, alt: 'Gallina de la granja asomándose en el gallinero de la Ecogranja Villa Juan' } },
  { image: { kind: 'local', asset: car10, alt: 'Perro con arnés de colores paseando por las zonas verdes de la Ecogranja Villa Juan' } },
  { image: { kind: 'local', asset: car12, alt: 'Dos caballos ensillados en las praderas verdes de la Ecogranja Villa Juan al atardecer' } },
  { image: { kind: 'local', asset: car13, alt: 'Visitante en cuatrimoto frente a la sede de la Ecogranja Villa Juan' } },
  { image: { kind: 'local', asset: car03, alt: 'Anfitriones de Villa Juan dando la bienvenida en la entrada del Granja Fest' } },
];
const galeria = await getGallery('home-galeria', galeriaSeed);
const galPos = {
  center: 'transform:translate(-50%,-50%) scale(1);z-index:30;opacity:1;filter:none;',
  right: 'transform:translate(-6%,-50%) scale(0.82) rotateY(-18deg);z-index:20;opacity:0.78;filter:brightness(0.82);',
  left: 'transform:translate(-94%,-50%) scale(0.82) rotateY(18deg);z-index:20;opacity:0.78;filter:brightness(0.82);',
  hidden: 'transform:translate(-50%,-50%) scale(0.6);z-index:0;opacity:0;filter:none;',
};
// Orden inicial (SSR / sin JS), espejo del render() del island: 0 = centro, 1 = derecha,
// último = izquierda, resto oculto. Así no se apilan al centro antes de que corra el JS.
const galInit = galeria.map((_, i) =>
  i === 0 ? galPos.center : i === 1 ? galPos.right : i === galeria.length - 1 ? galPos.left : galPos.hidden,
);
---

<Base heroHeader>
  <!-- HERO — carrusel de 4 slides detrás del header. Las hojas van DETRÁS del carrusel
       (-z-10, contexto raíz): las tapa el hero y asoman por debajo, por detrás de la
       sección siguiente (no cubren su contenido). -->
  <div class="relative">
    <HeroCarousel />
    <LeafDivider class="absolute inset-x-0 bottom-0 -z-10 translate-y-[50%]" />
  </div>

  <!-- EXPERIENCIAS TRANSFORMADORAS (bienvenida): banner + título + caballo + globo. -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <img
      src={expBanner.src}
      alt="Ecogranja · Experiencia transformadora"
      width="719"
      height="84"
      class="mx-auto mb-4 h-auto w-full max-w-md"
    />
    <h2 class="section-title text-center">
      Experiencias transformadoras en conexión con la naturaleza
    </h2>

    <div class="mt-10 grid items-center gap-6 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:gap-2">
      <img
        src={horseImg.src}
        alt="Don Juan, la mascota de la Ecogranja Villa Juan"
        width="522"
        height="501"
        loading="lazy"
        class="mx-auto w-48 sm:w-64 md:w-full md:max-w-sm md:translate-x-[20%]"
      />

      <!-- Globo de diálogo (imagen de fondo estirada) + texto blanco centrado dentro.
           `background-size:100% 100%` solo estira de verdad porque el SVG declara
           `preserveAspectRatio="none"`. Sin eso vuelve al default (`xMidYMid meet`):
           el globo conserva su 1.97:1, se centra, y en mobile —caja alta y angosta—
           el texto se sale por arriba y por abajo. Si se re-exporta el SVG desde el
           diseño, hay que volver a agregarle ese atributo. -->
      <div
        class="flex items-center justify-center px-8 py-8 sm:px-12 sm:py-10"
        style={`background-image:url('${globoImg.src}');background-size:100% 100%;background-repeat:no-repeat;`}
      >
        <p class="w-full text-center font-['Segoe_UI',system-ui,sans-serif] text-sm leading-relaxed text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.5)] sm:w-[70%] sm:text-base">
          Te invitamos a conocer la Ecogranja Villa Juan, un lugar increíble para salir de la rutina
          y reconectar con lo natural. Comparte con nuestros animales, aprende sobre el mundo equino y
          disfruta de los quehaceres reales del campo. Y no te puedes perder el sabor único de nuestro
          barril peruano. ¡Vente con tu familia a vivir un día de campo inolvidable!
        </p>
      </div>
    </div>
  </section>

  <!-- VIDEO — Fachada: el player de YouTube se carga al hacer clic. -->
  <section class="mx-auto max-w-4xl px-4 pb-16">
    <VideoEmbed
      id="rUnbtav3Nlo"
      title="Turismo cerca a Bogotá · Ecogranja Villa Juan — parque agroturístico para familias"
      poster={videoPoster}
    />
  </section>

  <!-- EXPLORA LO QUE OFRECEMOS — ofertas sobre una rama que sangra a la izquierda. -->
  <section class="overflow-hidden pb-16">
    <h2 class="mx-auto max-w-6xl px-4 text-center section-title">
      Explora lo que ofrecemos
    </h2>

    <!-- Desktop: Empresas ENCIMA de la rama; Pasadías, Celebraciones y Blog DEBAJO. -->
    <div class="relative mt-4 hidden h-[560px] w-full md:block lg:h-[720px]">
      <img
        src={ramaImg.src}
        alt=""
        aria-hidden="true"
        width="1429"
        height="445"
        class="pointer-events-none absolute top-1/2 left-0 w-[80%] -translate-y-1/2"
      />
      <a
        href={ofertaEmpresas.href}
        aria-label={ofertaEmpresas.label}
        class="absolute top-[1%] left-[36%] z-10 w-64 transition-transform duration-300 hover:-translate-y-2 lg:w-80"
      >
        <img
          src={ofertaEmpresas.img.src}
          alt={ofertaEmpresas.label}
          width={ofertaEmpresas.w}
          height={ofertaEmpresas.h}
          loading="lazy"
          class="w-full drop-shadow-xl"
        />
      </a>
      {
        ofertasAbajo.map((o) => (
          <a
            href={o.href}
            aria-label={o.label}
            class:list={[
              'absolute z-10 w-64 transition-transform duration-300 hover:-translate-y-2 lg:w-80',
              o.pos,
            ]}
          >
            <img src={o.img.src} alt={o.label} width={o.w} height={o.h} loading="lazy" class="w-full drop-shadow-xl" />
          </a>
        ))
      }
    </div>

    <!-- Mobile: grid simple de las 4 ofertas. -->
    <ul class="mx-auto mt-8 grid max-w-md grid-cols-2 gap-6 px-4 md:hidden">
      {
        ofertasMobile.map((o) => (
          <li>
            <a href={o.href} aria-label={o.label} class="block transition-transform hover:-translate-y-1">
              <img src={o.img.src} alt={o.label} width={o.w} height={o.h} loading="lazy" class="mx-auto w-40 drop-shadow-xl" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- BANDA negro → rojo → verde detrás de Sabor de fuego, Celebraciones y Villa Datos.
       Los extremos transparentes revelan el fondo verde continuo del sitio (blend). -->
  <div class="fire-band relative">
    <!-- SABOR DE FUEGO (barril) — centrado; el barril se "enciende" con el scroll. -->
    <section class="mx-auto max-w-3xl px-4 pt-16 pb-16 text-center text-white">
      <div class="relative mx-auto mb-6 w-[15.6rem] sm:w-[19.2rem]">
        <img
          src={barrilOff.src}
          alt="Barril de asado al carbón"
          width="507"
          height="546"
          loading="lazy"
          class="no-reveal w-full"
        />
        <img
          src={barrilOn.src}
          alt=""
          aria-hidden="true"
          width="507"
          height="546"
          loading="lazy"
          class="barril-on no-reveal absolute inset-0 w-full"
        />
      </div>
      <h2 class="section-title">Sabor de fuego</h2>
      <p class="mx-auto mt-4 max-w-2xl font-bold leading-relaxed text-white/90">
        La técnica es nuestra firma. Seleccionamos cortes de alta calidad con maduración controlada
        para intensificar cada matiz. Cocinamos al barril mediante calor indirecto con carbón vegetal;
        un proceso de horas que garantiza una jugosidad imposible de lograr en una parrilla
        convencional.
      </p>
      <a
        href={menuPdf.href}
        aria-label="Ver el menú"
        class="mt-6 inline-block transition-transform hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      >
        <img
          src={menuJeep.src}
          alt="Ver el menú"
          width="694"
          height="397"
          loading="lazy"
          class="mx-auto w-56 drop-shadow-xl sm:w-64"
        />
      </a>
    </section>

    <!-- CELEBRACIONES CON PROPÓSITO -->
    <section class="mx-auto max-w-4xl px-4 py-16 text-center">
      <h2 class="section-title">Celebraciones con propósito</h2>
      <p class="mt-4 text-lg font-bold leading-relaxed text-white/90">
        En la Ecogranja Villa Juan no solo alquilamos un espacio; diseñamos escenarios naturales para
        fortalecer equipos y celebrar la vida. Contamos con amplias zonas verdes y espacios cubiertos
        ideales para momentos únicos.
      </p>
      <SombreroTurntable class="mx-auto mt-8 w-[32rem] max-w-full sm:w-[40rem]" />
      <a
        href="/celebraciones"
        class="mt-4 inline-flex items-center justify-center rounded-full bg-brand-strong px-12 py-6 font-display text-3xl text-white ring-1 ring-white/30 transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:text-4xl"
      >
        Conocer eventos
      </a>
    </section>

    <!-- VILLA DATOS -->
    <section class="mx-auto max-w-6xl px-4 pt-16 pb-28 text-center text-white">
      <h2>
        <img
          src={tituloVillaDatos.src}
          alt="Villa Datos curiosos"
          width="539"
          height="462"
          loading="lazy"
          class="mx-auto w-56 drop-shadow-lg sm:w-64"
        />
      </h2>
      <img
        src={horseDatos.src}
        alt=""
        aria-hidden="true"
        width="1190"
        height="578"
        loading="lazy"
        class="mx-auto mt-2 w-full max-w-3xl"
      />
      <dl id="villa-datos" class="mt-10 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
        {
          stats.map((s, i) => (
            <div
              class="stat-circle mx-auto flex aspect-square w-full max-w-[13rem] flex-col items-center justify-center rounded-full bg-[#E3542A] p-6 text-center text-white shadow-xl ring-4 ring-white/15"
              style={`transition-delay:${i * 90}ms`}
            >
              <dt class="font-display text-sm leading-[0.95] [text-shadow:0_1px_2px_rgba(0,0,0,0.25)] sm:text-base">
                {s.label}
              </dt>
              <dd
                class="mt-2 text-2xl font-bold [text-shadow:0_1px_2px_rgba(0,0,0,0.25)] lg:text-3xl"
                data-count={s.n}
              >
                {fmt(s.n)}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>

  <!-- MUSEO DEL CABALLO — próximamente (panel naranja sobre el verde del sitio). -->
  <section class="mx-auto max-w-5xl px-4 py-8">
    <div class="rounded-[2.5rem] bg-cta-strong px-6 py-10 shadow-xl sm:px-10 md:px-12 md:py-14">
      <h2 class="text-center font-display text-3xl leading-tight text-[#FFF200] [text-shadow:0_2px_4px_rgba(0,0,0,0.35)] sm:text-4xl md:text-5xl">
        ¡Una nueva aventura está por galopar!
      </h2>

      <div class="mt-8 grid items-center gap-8 md:grid-cols-2 md:gap-10">
        <!-- Texto -->
        <div class="text-center text-white [text-shadow:0_1px_2px_rgba(0,0,0,0.35)] md:text-left">
          <p class="text-base leading-relaxed sm:text-lg">
            ¡Descubre el nuevo <strong>Museo del Caballo</strong> en Ecogranja Villa Juan!
            Explora el vínculo histórico entre humanos y equinos en un espacio diseñado para
            todas las edades. Aprende sobre su biología, comportamiento e impacto ambiental en un
            entorno natural único. Si buscas la mejor salida pedagógica o una experiencia de
            aprendizaje interactivo, ¡este será tu lugar favorito!
          </p>
          <p class="mt-6 font-bold sm:text-lg">
            Muy pronto, la magia de los caballos a tu alcance.
          </p>
        </div>

        <!-- Foto enmarcada + botón -->
        <div class="relative mx-auto w-full max-w-sm pb-6">
          <div class="overflow-hidden rounded-[2rem] bg-white p-2 shadow-lg ring-1 ring-black/10">
            <Image
              src={fuenteCaballos}
              alt="Monumento a los caballos en la Ecogranja Villa Juan"
              widths={[400, 640, 900]}
              sizes="(min-width: 768px) 40vw, 90vw"
              format="webp"
              quality={72}
              loading="lazy"
              class="h-64 w-full rounded-[1.5rem] object-cover sm:h-72"
            />
          </div>
          <!-- Sin JS: enlace directo a WhatsApp. Con JS: abre el modal (NotifyDialog). -->
          <a
            href={wa('Quiero que me avisen la apertura del Museo del Caballo')}
            data-notify-open
            class="absolute bottom-0 left-1/2 inline-flex -translate-x-1/2 items-center justify-center rounded-full bg-brand-strong px-8 py-3 font-display text-xl text-white shadow-lg ring-1 ring-white/30 transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            Notificarme Apertura
          </a>
        </div>
      </div>
    </div>
  </section>

  <NotifyDialog />

  <!-- CRÓNICAS DE LA TIERRA — blog destacado (panel naranja + caballo recostado arriba). -->
  <section class="mx-auto max-w-5xl px-4 pb-8 pt-36 sm:pt-44 md:pt-52">
    <div class="relative rounded-[2.5rem] bg-cta-strong px-5 pb-10 pt-28 shadow-xl sm:px-10 sm:pt-32 md:px-12">
      <!-- Caballo recostado: sobresale por el borde superior del panel. -->
      <Image
        src={horseCronicas}
        alt="Juan, la mascota de Villa Juan, recostado"
        widths={[400, 640, 900]}
        sizes="(min-width: 768px) 36rem, 20rem"
        format="webp"
        quality={80}
        loading="lazy"
        class="pointer-events-none absolute -top-32 left-1/2 w-80 -translate-x-1/2 [filter:drop-shadow(0_8px_16px_rgba(0,0,0,0.3))] sm:-top-44 sm:w-[30rem] md:-top-52 md:w-[36rem]"
      />

      <!-- Título con hojas. -->
      <img
        src={tituloCronicas.src}
        alt="Crónicas de la Tierra"
        width={tituloCronicas.width}
        height={tituloCronicas.height}
        class="mx-auto w-64 [filter:drop-shadow(0_4px_10px_rgba(0,0,0,0.25))] sm:w-80"
      />

      <!-- Tarjetas de posts. -->
      <div class="mt-8 grid gap-5 sm:mt-10 sm:grid-cols-2 sm:gap-6">
        {
          cronicas.map((p) => (
            <article class="flex flex-col overflow-hidden rounded-3xl bg-surface p-3 text-center shadow-lg">
              <Image
                src={p.img}
                alt={p.alt}
                widths={[320, 480, 640]}
                sizes="(min-width: 640px) 22rem, 90vw"
                format="webp"
                quality={72}
                loading="lazy"
                class="h-40 w-full rounded-2xl object-cover"
              />
