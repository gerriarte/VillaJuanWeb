---
/**
 * Menú del restaurante: el PDF embebido dentro del sitio (header + footer del layout).
 * Los botones "Ver menú" del home, del carrusel y de Villa Planes apuntan acá.
 */
import Base from '../layouts/Base.astro';
import PdfViewer from '../components/sections/PdfViewer.astro';
import { menuPdf } from '../lib/pdfs';
import { getMenuPdf } from '../lib/planes';

// El archivo es editable en Directus (documentos → menu); sin CMS, el del repo.
const file = await getMenuPdf();
---

<Base
  title="Menú del restaurante campestre | Ecogranja Villa Juan"
  description={menuPdf.description}
>
  <PdfViewer
    title={menuPdf.title}
    file={file.url}
    filename={file.filename}
    description={menuPdf.description}
    backHref="/villa-planes"
    backLabel="Villa Planes"
    waText={menuPdf.waText}
    ctaLabel="Reservar mesa por WhatsApp"
  />
</Base>
