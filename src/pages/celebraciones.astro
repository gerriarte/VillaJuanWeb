---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { wa } from '../lib/site';
import heroImg from '../assets/images/celebraciones/Banner_Celebraciones.jpg';
import celeHorse from '../assets/images/celebraciones/Celebraciones_horse.png';
import imgCumpleanos from '../assets/images/celebraciones/Cumpleaños_Villa_Juan.jpg';
import imgXV from '../assets/images/celebraciones/xvanos_image.png';
import imgBoda from '../assets/images/celebraciones/boda_campestre_image.png';
import imgReencuentro from '../assets/images/celebraciones/Reencuentros_Familiares.jpg';
import imgComunion from '../assets/images/celebraciones/Primeras_comuniones.jpg';
import { getCards, type Card } from '../lib/content';
import { assetUrl } from '../lib/directus';

// Semilla local (fallback). En Directus: colección `cards`, section=celebraciones.
const seed: Card[] = [
  { title: 'Cumpleaños', note: 'Para grupos de 10 personas en adelante*', imageRight: true,
    image: { kind: 'local', asset: imgCumpleanos, alt: 'Torta de cumpleaños y brindis al aire libre en Villa Juan' },
    body: 'Celebra tu cumpleaños en Ecogranja Villa Juan y vive una experiencia única rodeada de naturaleza, diversión y momentos inolvidables. Disfruta de amplios espacios al aire libre, ideales para compartir con familiares y amigos, y aprovecha nuestras promociones especiales: recibe la torta para todo el grupo y la decoración del espacio completamente gratis, o elige el pasadía gratuito para el cumpleañero. Todo en un entorno campestre perfecto para celebrar, disfrutar y crear recuerdos especiales.' },
  { title: 'XV Años y Grados', imageRight: false,
    image: { kind: 'local', asset: imgXV, alt: 'Celebración de XV años iluminada en la noche campestre' },
    body: 'El lugar perfecto para una celebración vibrante y llena de estilo. Espacios abiertos para fotos increíbles y zonas de fiesta seguras y amplias.' },
  { title: 'Bodas Campestres', imageRight: true,
    image: { kind: 'local', asset: imgBoda, alt: 'Ceremonia de boda campestre al atardecer en Villa Juan' },
    body: "Un 'Sí, acepto' rodeado de atardeceres mágicos y el encanto del campo. Ofrecemos escenarios instagrameables y una logística impecable para el día más importante de tu vida." },
  { title: 'Reencuentros Familiares', imageRight: false,
    image: { kind: 'local', asset: imgReencuentro, alt: 'Familia disfrutando un día de campo en Villa Juan' },
    body: 'Celebramos la unión. Disfruta de un día de campo con actividades para todas las edades, desde los más pequeños hasta los abuelos.' },
  { title: 'Primeras Comuniones y Bautizos', imageRight: true,
    image: { kind: 'local', asset: imgComunion, alt: 'Decoración de primera comunión al aire libre en Villa Juan' },
    body: 'Ambientes tranquilos y acogedores para compartir la fe y la alegría en familia, con menús que encantan a todos.' },
];
const celebraciones = await getCards('celebraciones', seed);
---

<Base
  heroHeader
  title="Celebraciones · Bodas, XV, cumpleaños y eventos en Tenjo | Ecogranja Villa Juan"
  description="Celebra en la Ecogranja Villa Juan: bodas campestres, XV años, cumpleaños, reencuentros familiares y primeras comuniones en escenarios naturales cerca de Bogotá."
>
  <!-- HERO — salón decorado, imagen full-bleed detrás del header flotante. -->
  <section class="relative">
    <Image
      src={heroImg}
      alt="Salón campestre decorado para una celebración en la Ecogranja Villa Juan"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      format="webp"
      quality={72}
      loading="eager"
      fetchpriority="high"
      class="h-[52vh] min-h-[360px] w-full object-cover sm:h-[64vh]"
    />
  </section>

  <!-- INTRO — título + caballo con globo naranja + párrafo. -->
  <section>
    <div class="mx-auto max-w-5xl px-4 py-16">
      <h1 class="title-outline text-center font-display leading-[1.05] text-[length:clamp(2.25rem,7vw,48pt)]">
        Tus mejores momentos merecen un escenario natural
      </h1>

      <div class="mt-10 grid items-center gap-6 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
        <Image
          src={celeHorse}
          alt="Don Juan celebrando con un cupcake en la Ecogranja Villa Juan"
          widths={[224, 336, 448]}
          sizes="(min-width: 640px) 16rem, 14rem"
          format="webp"
          quality={80}
          loading="lazy"
          class="mx-auto w-56 [filter:drop-shadow(0_8px_16px_rgba(0,0,0,0.25))] sm:w-64"
        />
        <div class="rounded-[2rem] bg-cta-strong p-6 text-white shadow-lg sm:p-8">
          <p class="text-lg leading-relaxed [text-shadow:0_1px_2px_rgba(0,0,0,0.25)]">
            En la Ecogranja Villa Juan no solo alquilamos un espacio; diseñamos escenarios naturales
            para fortalecer equipos y celebrar la vida. Contamos con amplias zonas verdes y espacios
            cubiertos ideales para momentos únicos.
          </p>
        </div>
      </div>

      <p class="mx-auto mt-10 max-w-4xl text-center text-lg leading-relaxed text-ink/90">
        Nuestra infraestructura no solo destaca por su belleza, sino por su funcionalidad. Contamos
        con amplias zonas de parqueadero privado, seguridad permanente y un equipo de colaboradores
        expertos que acompañan tu evento de principio a fin. En Ecogranja Villa Juan, tu única
        responsabilidad es celebrar; nosotros nos encargamos de que todo salga perfecto.
      </p>
    </div>
  </section>

  <!-- TARJETAS DE CELEBRACIÓN — imagen alterna izq/der. -->
  <section>
    <div class="mx-auto max-w-5xl space-y-8 px-4 pb-16">
      {
        celebraciones.map((c) => (
          <article class="grid gap-5 rounded-[2rem] bg-surface p-4 shadow-xl sm:p-6 md:grid-cols-2 md:items-center md:gap-8">
            {c.image.kind === 'directus' ? (
              <img
                src={assetUrl(c.image.id, { width: 760 })}
                alt={c.image.alt}
                loading="lazy"
                class:list={['h-52 w-full rounded-[1.5rem] object-cover sm:h-64', c.imageRight && 'md:order-last']}
              />
            ) : (
              <Image
                src={c.image.asset}
                alt={c.image.alt}
                widths={[360, 560, 760]}
                sizes="(min-width: 768px) 24rem, 90vw"
                format="webp"
                quality={72}
                loading="lazy"
                class:list={['h-52 w-full rounded-[1.5rem] object-cover sm:h-64', c.imageRight && 'md:order-last']}
              />
            )}
            <div class="px-1 text-center md:text-left">
              <h2 class="card-title">
                {c.title}
                {c.note && (
                  <span class="mt-1 block font-body text-xs font-semibold text-ink/60">{c.note}</span>
                )}
              </h2>
              <p class="mt-3 leading-relaxed text-ink/75">{c.body}</p>
              <a
                href={wa(`Quiero reservar para ${c.title}`)}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 inline-flex items-center justify-center rounded-full bg-cta-strong px-8 py-2.5 font-display text-lg text-white shadow transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cta-strong"
              >
                Reservar
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>
