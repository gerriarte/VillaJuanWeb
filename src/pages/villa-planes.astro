---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import LeafDivider from '../components/layout/LeafDivider.astro';
import { wa } from '../lib/site';
import { getCards, getGallery, type Photo } from '../lib/content';
import MediaGallery from '../components/sections/MediaGallery.astro';
import { assetUrl } from '../lib/directus';
// Hero: picada al barril vista desde arriba (original PNG de 4992×3328, 36 MB → 2400px WebP).
import heroImg from '../assets/images/villa-planes/hero_comida_al_barril.webp';
import tituloVP from '../assets/images/villa-planes/Conoce_Villa_Planes.webp';
import verMenu from '../assets/images/villa-planes/vermenu.png';
import reservaYa from '../assets/images/villa-planes/Reserva.webp';
import barril1 from '../assets/images/villa-planes/Seleccion_y_Maduracion.png';
import barril2 from '../assets/images/villa-planes/Sazonado_Artesanal.jpg';
import barril3 from '../assets/images/villa-planes/Cocción_al_barril.jpg';
import barril4 from '../assets/images/villa-planes/Espectaculo_en_vivo.jpg';
import tallerImg from '../assets/images/villa-planes/taller.webp';
// Platos de la carta (mini galería sobre "El Arte de nuestra Carne al Barril").
// Originales: PNG de 5472×3648 (~35 MB c/u); acá entran ya reducidos a 1600px WebP.
import comidaChurrasco from '../assets/images/villa-planes/comida/churrasco.webp';
import comidaEmpanaditas from '../assets/images/villa-planes/comida/empanaditas.webp';
import comidaChicharroncitos from '../assets/images/villa-planes/comida/chicharroncitos.webp';
import comidaPatacon from '../assets/images/villa-planes/comida/patacon-ahogado.webp';
import comidaPatacon2 from '../assets/images/villa-planes/comida/patacon-ahogado-2.webp';
import comidaFiambre from '../assets/images/villa-planes/comida/fiambre.webp';
import selfieAnimales from '../assets/images/villa-planes/Selfie.webp';
import contactanos from '../assets/images/home/contactanos.png';
// Tronco recortado a la madera pura (el original trae ~33% de transparente arriba y abajo,
// lo que hacía que el borde superior de la madera se moviera con el ancho del viewport).
import tronco from '../assets/images/villa-planes/Tronco_fondo_madera.webp';
import cartel from '../assets/images/villa-planes/Cartel_Villa_Planes.webp';
// Planes como gráficos de texto (Sunrise, por color). Orden del mockup: Trote, Trocha, Paso Fino.
// Cada botón lleva a la página del plan, donde el PDF se ve EMBEBIDO con header y footer
// (no se enlaza el archivo suelto: el visitante vuelve y sigue navegando).
import { planPdfs, menuPdf } from '../lib/pdfs';

// Tabla comparativa. Marcas coloreadas por columna (verde / rojo / dorado).
// Colores OSCURECIDOS para contraste AA sobre celda clara (invariante #2): estos mismos
// colores tiñen el título de columna y los íconos ✓/✗.
const columns = [
  { label: 'Trote y Galope', color: '#00811e' },
  { label: 'Trocha y Galope', color: '#c0360d' },
  { label: 'Paso Fino', color: '#9a6a0e' },
];
const rows: { name: string; v: boolean[] }[] = [
  { name: 'Desayuno de la granja', v: [false, false, true] },
  { name: 'Espacio exclusivo', v: [true, true, true] },
  { name: 'Recorrido granja', v: [true, true, true] },
  { name: 'Taller de ordeño', v: [true, true, true] },
  { name: 'Almuerzo a la carta', v: [true, true, true] },
  { name: 'GranjaFest', v: [true, true, true] },
  { name: 'Feria de juegos tradicionales', v: [true, true, true] },
  { name: 'Show Villa Juan', v: [true, true, true] },
  { name: 'Paseo a caballo o Paseo a cuatrimoto', v: [false, true, true] },
];

// El arte de la carne al barril — 4 pasos (CMS: cards, section=villaplanes-barril).
const barrilSteps = await getCards('villaplanes-barril', [
  { title: 'Selección y Maduración', imageRight: false, image: { kind: 'local', asset: barril1, alt: 'Selección y Maduración' },
    body: 'Elegimos cortes de alta calidad con una maduración controlada. Este proceso natural intensifica el sabor y garantiza una textura excepcionalmente tierna antes de tocar el fuego.' },
  { title: 'Sazonado Artesanal', imageRight: false, image: { kind: 'local', asset: barril2, alt: 'Sazonado Artesanal' },
    body: 'Aplicamos una mezcla de especias seleccionadas que realzan el perfil cárnico sin opacarlo, preparando la pieza para su transformación en el ahumador.' },
  { title: 'Cocción al Barril', imageRight: false, image: { kind: 'local', asset: barril3, alt: 'Cocción al Barril' },
    body: 'Usamos calor indirecto con carbón vegetal. Al no haber llama directa, la carne se cocina uniformemente por horas, conservando todos sus jugos y logrando un dorado exterior perfecto.' },
  { title: 'Espectáculo en Vivo', imageRight: false, image: { kind: 'local', asset: barril4, alt: 'Espectáculo en Vivo' },
    body: 'La preparación final se realiza frente a tus ojos. Más que una cena, es un show gastronómico donde la suavidad y el aroma del ahumado son los protagonistas de tu evento.' },
]);

// Mini galería de platos, arriba de "El Arte de nuestra Carne al Barril".
// Editable en Directus: colección `gallery`, section `villaplanes-comida`. Semilla local.
const comidaSeed: Photo[] = [
  { image: { kind: 'local', asset: comidaChurrasco, alt: 'Churrasco con papas a la francesa servido en tabla de madera' } },
  { image: { kind: 'local', asset: comidaEmpanaditas, alt: 'Canasta de empanaditas con ají picado' } },
  { image: { kind: 'local', asset: comidaChicharroncitos, alt: 'Chicharroncitos crocantes con guacamole' } },
  { image: { kind: 'local', asset: comidaPatacon2, alt: 'Patacones con salsa de ahogado' } },
  { image: { kind: 'local', asset: comidaPatacon, alt: 'Patacón con ahogado servido en la mesa campestre' } },
  { image: { kind: 'local', asset: comidaFiambre, alt: 'Fiambre campesino servido sobre hoja de plátano' } },
];
const comidaGaleria = await getGallery('villaplanes-comida', comidaSeed);
---

<Base
  heroHeader
  title="Villa Planes · Pasadías y ecoturismo en Tenjo | Ecogranja Villa Juan"
  description="Villa Planes: pasadías de ecoturismo en la Sabana de Bogotá. Trote y Galope, Trocha y Galope o Paso Fino, con desayuno de la granja, recorridos, gastronomía al barril y show Villa Juan."
>
  <!-- HERO — delicias al barril, imagen full-bleed detrás del header flotante. Las hojas van
       DETRÁS del banner (-z-10, contexto raíz) y asoman por debajo, por detrás de la sección siguiente. -->
  <section class="relative">
    <Image
      src={heroImg}
      alt="Manos compartiendo una picada de empanadas, patacones, chorizo y salsas en la mesa de madera de la Ecogranja Villa Juan"
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      format="webp"
      quality={82}
      loading="eager"
      fetchpriority="high"
      class="h-[80dvh] w-full object-cover sm:h-dvh"
    />
    <LeafDivider class="absolute inset-x-0 bottom-0 -z-10 translate-y-[50%]" />
  </section>

  <!-- CONOCE LOS VILLA PLANES — intro + selfie + botones de planes. -->
  <section>
    <div class="mx-auto max-w-6xl px-4 pt-16 pb-0 text-ink">
      <Image
        src={tituloVP}
        alt="Conoce los ¡Villa Planes!"
        widths={[384, 640, 960]}
        sizes="(min-width: 640px) 30rem, 18rem"
        format="webp"
        quality={80}
        loading="lazy"
        class="mx-auto w-72 [filter:drop-shadow(0_4px_10px_rgba(0,0,0,0.2))] sm:w-[30rem]"
      />

      <div class="mx-auto mt-8 max-w-3xl space-y-5 text-center text-lg leading-relaxed text-on-green">
        <p>
          ¿Buscas escapar de la rutina y respirar aire puro sin pasar horas en el tráfico? En
          <strong class="text-cta-strong">Eco Granja Villa Juan</strong>, ubicada en Tenjo,
          Cundinamarca, diseñamos la escapada perfecta para ti. A solo unos minutos del norte de
          Bogotá, te espera un espacio único rodeado de naturaleza, aventura y tranquilidad.
        </p>
        <p>
          Nuestros <strong class="text-cta-strong">Villa Planes</strong> están pensados para quienes
          buscan el mejor ecoturismo en la Sabana de Bogotá. Ya sea que estés planeando una escapada
          de fin de semana en <strong class="text-cta-strong">familia</strong>, un plan romántico en
          <strong class="text-cta-strong">pareja</strong> o un día de retos y trabajo en equipo con
          <strong class="text-cta-strong">amigos</strong>, tenemos una experiencia a tu medida.
        </p>
      </div>

      <div class="mt-10 grid items-end gap-8 md:grid-cols-[1.7fr_1fr]">
        <Image
          src={selfieAnimales}
          alt="Don Juan tomándose una selfie con los animales de la Ecogranja Villa Juan"
          widths={[480, 768, 1100, 1300]}
          sizes="(min-width: 768px) 62vw, 100vw"
          format="webp"
          quality={72}
          loading="lazy"
          class="relative z-10 order-last -mb-[2%] w-full md:order-first md:self-end"
        />
        <div>
          <p class="text-center font-bold text-on-green md:text-right">
            Mira el <span class="text-cta-strong">.pdf</span> de tu Villa Plan favorito*
          </p>
          <ul class="mx-auto mt-5 flex max-w-xs flex-col gap-3 md:mx-0 md:ml-auto">
            {
              planPdfs.map((p) => (
                <li>
                  <a
                    href={p.href}
                    aria-label={`Ver el Villa Plan ${p.title} (PDF)`}
                    style={`background-image:${p.grad};`}
                    class="flex w-full items-center justify-center rounded-full px-6 py-3 shadow-lg ring-1 ring-black/10 transition hover:brightness-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                  >
                    <Image
                      src={p.img}
                      alt={p.title}
                      widths={[160, 240, 320]}
                      sizes="10rem"
                      format="webp"
                      quality={85}
                      loading="lazy"
                      class="h-14 w-auto [filter:drop-shadow(0_2px_5px_rgba(0,0,0,0.45))] sm:h-16"
                    />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- BANNER — cartel "¡Villa Planes!" sobre tronco de madera full-bleed. -->
  <section class="relative flex items-center justify-center overflow-hidden">
    <img
      src={tronco.src}
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <Image
      src={cartel}
      alt="¡Villa Planes!"
      widths={[320, 480, 640]}
      sizes="(min-width: 640px) 26rem, 80vw"
      format="webp"
      quality={82}
      loading="lazy"
      class="relative w-64 [filter:drop-shadow(0_6px_12px_rgba(0,0,0,0.35))] sm:w-[26rem]"
    />
  </section>

  <!-- TABLA COMPARATIVA de planes. -->
  <section>
    <div class="mx-auto max-w-4xl px-4 pb-12">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[34rem] border-separate border-spacing-1.5 text-center">
          <thead>
            <tr>
              <th scope="col" class="w-2/5 rounded-2xl bg-cta-strong px-3 py-3 text-left align-bottom font-display text-2xl leading-none tracking-[2pt] text-white sm:text-3xl">
                Villa <br /> Planes
              </th>
              {
                columns.map((c) => (
                  <th
                    scope="col"
                    class="rounded-2xl bg-white/85 px-2 py-3 align-bottom font-display text-xl leading-tight tracking-[2pt] ring-1 ring-black/10 sm:text-2xl"
                    style={`color:${c.color};`}
                  >
                    {c.label}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row) => (
                <tr>
                  <th
                    scope="row"
                    class="rounded-2xl bg-cta-strong px-4 py-3 text-left font-body text-base font-bold leading-snug text-white sm:text-lg"
                  >
                    {row.name}
                  </th>
                  {
                    row.v.map((ok, i) => (
                      <td class="rounded-2xl bg-white/70 ring-1 ring-black/10">
                        <span class="sr-only">{ok ? 'Incluido' : 'No incluido'}</span>
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                          class="mx-auto h-7 w-7 sm:h-8 sm:w-8 [filter:drop-shadow(0_1px_1px_rgba(0,0,0,0.25))]"
                          style={`color:${columns[i].color};`}
                        >
                          {ok ? <path d="M4 12.5l5 5L20 6" /> : <path d="M6 6l12 12M18 6L6 18" />}
                        </svg>
                      </td>
                    ))
                  }
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <!-- Contáctanos -->
      <div class="mt-10 flex justify-center">
        <a href={wa('Quiero información de los Villa Planes')} target="_blank" rel="noopener noreferrer" aria-label="Contáctanos por WhatsApp" class="transition-transform hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
          <Image
            src={contactanos}
            alt="Contáctanos — Don Juan, la mascota de Villa Juan"
            widths={[240, 360, 480]}
            sizes="16rem"
            format="webp"
            quality={80}
            loading="lazy"
            class="w-52 [filter:drop-shadow(0_8px_16px_rgba(0,0,0,0.25))] sm:w-64"
          />
        </a>
      </div>
    </div>
  </section>

  <!-- GASTRONOMÍA + CARNE AL BARRIL — banda con degradé negro→rojo revelado por scroll
       (mismo efecto "fire-band" del home). Extremos transparentes → blend con el verde del sitio. -->
  <section class="fire-band relative text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.45)]">
    <div class="mx-auto max-w-4xl px-4 pt-16 pb-8 text-center">
      <h2 class="font-display text-4xl text-[#0cbd35] [text-shadow:0_2px_0_#fff,0_-1px_0_#fff,1px_0_0_#fff,-1px_0_0_#fff] sm:text-5xl">
        Gastronomía de Origen
      </h2>
      <p class="mx-auto mt-6 max-w-3xl leading-relaxed">
        En Ecogranja Villa Juan, transformamos la gastronomía en una experiencia inolvidable. Nuestra
        propuesta culinaria es un homenaje a la diversidad de nuestra tierra, combinando la maestría
        artesanal de los cortes al barril con los sabores más reconfortantes de la cocina tradicional
        colombiana. Cada plato es una invitación a recordar el calor del hogar a través de recetas
        auténticas.
      </p>
      <p class="mt-6 font-bold">Una Experiencia Gastronómica en Contacto con la Naturaleza</p>
      <p class="mx-auto mt-2 max-w-3xl leading-relaxed">
        Creemos firmemente en el valor de lo local. Por ello, nuestra carta destaca por la frescura de
        ingredientes regionales, seleccionados cuidadosamente para garantizar una explosión de sabor
        en cada bocado. Ya sea que busques compartir platos típicos en familia o deleitarte con
        nuestras exclusivas especialidades de la casa, aquí encontrarás el equilibrio perfecto entre
        sazón y bienestar.
      </p>

      <a
        href={menuPdf.href}
        aria-label="Ver el menú (PDF)"
        class="mt-8 inline-block transition-transform hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      >
        <img
          src={verMenu.src}
          alt="Ver el menú"
          width={verMenu.width}
          height={verMenu.height}
          loading="lazy"
          class="mx-auto w-52 [filter:drop-shadow(0_6px_12px_rgba(0,0,0,0.3))] sm:w-60"
        />
      </a>
    </div>

    <div class="mx-auto max-w-6xl px-4 pt-8 pb-16 text-center">
      <!-- Galería de platos: 3 columnas (fotos grandes) y clic para ampliar en el lightbox.
           Sin JS cada foto es un link a su versión grande, así que se amplía igual. -->
      <div class="mb-12">
        <MediaGallery
          id="galeria-comida"
          photos={comidaGaleria}
          gridClass="grid-cols-2 sm:grid-cols-3"
          sizes="(min-width: 1024px) 22rem, (min-width: 640px) 30vw, 45vw"
        />
      </div>

      <h2 class="font-display text-4xl text-[#FFF200] [text-shadow:0_2px_4px_rgba(0,0,0,0.35)] sm:text-5xl">
        El Arte de nuestra Carne al Barril
      </h2>
      <p class="mx-auto mt-5 max-w-3xl leading-relaxed">
        En Ecogranja Villa Juan, elevamos la gastronomía rústica a un nivel superior. Nuestra técnica
        de cocción al barril no es solo una forma de preparar alimentos; es un ritual artesanal
        diseñado para honrar la calidad de nuestros cortes y ofrecerte una explosión de jugosidad en
        cada bocado.
      </p>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          barrilSteps.map((s) => (
            <article class="flex flex-col overflow-hidden rounded-3xl bg-surface p-3 text-center shadow-lg [text-shadow:none]">
              {s.image.kind === 'directus' ? (
                <img src={assetUrl(s.image.id, { width: 560 })} alt={s.image.alt} loading="lazy" class="h-36 w-full rounded-2xl object-cover" />
              ) : (
                <Image
                  src={s.image.asset}
                  alt={s.image.alt}
                  widths={[280, 400, 560]}
                  sizes="(min-width: 1024px) 16rem, (min-width: 640px) 40vw, 90vw"
                  format="webp"
                  quality={72}
                  loading="lazy"
                  class="h-36 w-full rounded-2xl object-cover"
                />
              )}
              <h3 class="mt-4 card-title">{s.title}</h3>
              <p class="mt-2 grow px-1 pb-1 text-sm text-ink/70">{s.body}</p>
            </article>
          ))
        }
      </div>

      <a
        href={wa('Quiero reservar una experiencia gastronómica al barril')}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Reserva ya"
        class="mt-10 inline-block transition-transform hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      >
        <Image
          src={reservaYa}
          alt="¡Reserva ya!"
          widths={[208, 320, 416]}
          sizes="(min-width: 640px) 13rem, 11rem"
          format="webp"
          quality={80}
          loading="lazy"
          class="mx-auto w-44 [filter:drop-shadow(0_8px_14px_rgba(0,0,0,0.35))] sm:w-52"
        />
      </a>
    </div>
  </section>

  <!-- TALLER ASADOS AL BARRIL -->
  <section>
    <div class="mx-auto max-w-5xl px-4 py-16">
      <h2 class="section-title text-center">
        Taller asados al Barril
      </h2>

      <div class="mt-10 grid items-center gap-6 rounded-[2.5rem] bg-surface p-4 shadow-xl sm:grid-cols-2 sm:gap-8 sm:p-6">
        <Image
          src={tallerImg}
          alt="Costillas asándose dentro del barril en un taller de Villa Juan"
          widths={[400, 640, 900]}
          sizes="(min-width: 640px) 28rem, 90vw"
          format="webp"
          quality={74}
          loading="lazy"
          class="h-full max-h-80 w-full rounded-[1.8rem] object-cover"
        />
        <div class="text-center sm:text-left">
          <p class="leading-relaxed text-ink/80">
            Conviértete en un maestro parrillero y domina el arte de la cocción lenta en nuestros
            talleres especializados de asado al barril. Aprenderás las mejores técnicas de marinado,
            manejo del fuego y secretos gastronómicos para lograr carnes jugosas con ese sabor ahumado
            único de la granja. Es el plan ideal para compartir con amigos o familia mientras
            disfrutas del aire libre y descubres el placer de cocinar con paciencia y tradición en un
            entorno natural inolvidable.
          </p>
          <a
            href={wa('Quiero información sobre el taller de asados al barril.')}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center justify-center rounded-full bg-cta-strong px-8 py-3 font-display text-xl text-white shadow-lg transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cta-strong"
          >
            Saber más
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Banda "Gastronomía": degradé negro→rojo cuya opacidad se revela con el scroll
     (var --fire, la maneja el script). Extremos transparentes → blend con el verde del
     sitio. Fallback sin JS o reduce-motion = color estático (--fire: 1). Igual que el home. */
  .fire-band::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: linear-gradient(
      180deg,
      transparent 0%,
      #0d0605 14%,
      #0d0605 30%,
      #5c0f06 48%,
      #a31d0b 68%,
      #a31d0b 90%,
      transparent 100%
    );
    opacity: var(--fire, 1);
    transition: opacity 0.7s ease-out;
    will-change: opacity;
  }
</style>

<script>
  // Revela el color de la banda "Gastronomía" (var --fire) según el scroll. Igual que el
  // reveal de la banda "Sabor de fuego" del home. Respeta prefers-reduced-motion.
  const fireBand = document.querySelector<HTMLElement>('.fire-band');
  if (fireBand && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    fireBand.style.setProperty('--fire', '0');
    const update = () => {
      const r = fireBand.getBoundingClientRect();
      const vh = window.innerHeight;
      // Reveal sutil: arranca al asomar la sección por abajo (r.top≈vh) y se reparte sobre
      // un rango ancho (~1.4 viewport), suavizado con smoothstep.
      const raw = Math.min(1, Math.max(0, (vh - r.top) / (vh * 1.4)));
      const eased = raw * raw * (3 - 2 * raw);
      fireBand.style.setProperty('--fire', eased.toFixed(3));
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }
</script>
