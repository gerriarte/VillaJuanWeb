---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import LeafDivider from '../../components/layout/LeafDivider.astro';
import banner from '../../assets/images/blog/Blog.jpg';
import { getPosts, categories } from '../../lib/blog';
import { assetUrl } from '../../lib/directus';

const posts = await getPosts();
---

<Base
  heroHeader
  title="Blog · Historias de la Granja | Villa Juan"
  description="Historias de la Granja: cocina al barril, bienestar en la naturaleza, mundo equino y todo para que tu próxima visita a Ecogranja Villa Juan sea inolvidable."
>
  <!-- HERO — banner full-bleed (header flota encima). Las hojas van DETRÁS del banner
       (-z-10, contexto raíz) y asoman por debajo, por detrás de la sección siguiente. -->
  <section class="relative">
    <Image
      src={banner}
      alt="Recorriendo la Ecogranja Villa Juan en cuatrimoto"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      format="webp"
      quality={72}
      loading="eager"
      fetchpriority="high"
      class="h-[80dvh] w-full border-4 border-brand-strong object-cover sm:h-dvh"
    />
    <LeafDivider class="absolute inset-x-0 bottom-0 -z-10 translate-y-[50%]" />
  </section>

  <!-- INTRO — título a dos tamaños + bienvenida. Texto oscuro (ink): blanco falla AA
       sobre el verde lima del fondo (invariante #2). -->
  <section class="mx-auto max-w-4xl px-4 pt-16 text-center">
    <h1 class="section-title">
      Historias de la Granja
      <span class="block text-[0.62em] leading-tight">Naturaleza, tradición y bienestar</span>
    </h1>
    <p class="mx-auto mt-8 max-w-3xl text-lg leading-relaxed text-on-green">
      Bienvenido a nuestro rincón digital: un espacio para los amantes de la vida de campo y las
      experiencias auténticas. Aquí compartimos los secretos de nuestra cocina al barril, consejos
      para conectar con la naturaleza, curiosidades del mundo equino y todo lo que necesitas para que
      tu próxima visita sea inolvidable.
    </p>
  </section>

  <!-- CATEGORÍAS — filtros. Island mínima (vanilla): filtra los artículos por categoría.
       Sin JS, todos los posts se ven y las pastillas quedan como etiquetas inertes. -->
  <section class="mx-auto max-w-5xl px-4 pt-10">
    <h2 class="sr-only">Filtrar por categoría</h2>
    <ul id="cat-filter" class="flex flex-wrap justify-center gap-3">
      <li>
        <button
          type="button"
          data-cat="*"
          aria-pressed="true"
          class="cat-pill cursor-pointer rounded-full bg-brand-strong px-5 py-2 font-display text-sm tracking-[1pt] text-white ring-1 ring-white/20 transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white aria-pressed:bg-cta-strong aria-pressed:ring-white/40"
        >
          Todos
        </button>
      </li>
      {
        categories.map((c) => (
          <li>
            <button
              type="button"
              data-cat={c}
              aria-pressed="false"
              class="cat-pill cursor-pointer rounded-full bg-brand-strong px-5 py-2 font-display text-sm tracking-[1pt] text-white ring-1 ring-white/20 transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white aria-pressed:bg-cta-strong aria-pressed:ring-white/40"
            >
              {c}
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ARTÍCULOS — grid de cards. -->
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="sr-only">Artículos</h2>
    <div id="post-grid" class="grid gap-6 sm:grid-cols-2">
      {
        posts.map((post) => (
          <article
            data-cats={post.categories.join('|')}
            class="flex flex-col overflow-hidden rounded-3xl bg-surface shadow-lg ring-1 ring-black/5"
          >
            {post.image.kind === 'directus' ? (
              <img
                src={assetUrl(post.image.id, { width: 640 })}
                alt={post.image.alt}
                loading="lazy"
                class="aspect-[16/10] w-full object-cover"
              />
            ) : (
              <Image
                src={post.image.asset}
                alt={post.image.alt}
                widths={[320, 480, 640]}
                sizes="(min-width: 640px) 40vw, 90vw"
                format="webp"
                quality={72}
                loading="lazy"
                class="aspect-[16/10] w-full object-cover"
              />
            )}
            <div class="flex flex-1 flex-col gap-3 p-5">
              <p class="font-display text-xs tracking-[1pt] text-cta-strong uppercase">{post.categories[0]}</p>
              <h3 class="card-title">{post.title}</h3>
              <p class="text-sm leading-relaxed text-ink/75">{post.excerpt}</p>
              <a
                href={`/blog/${post.slug}`}
                aria-label={`Leer más: ${post.title}`}
                class="mt-auto inline-flex w-fit items-center justify-center rounded-full bg-cta-strong px-6 py-2.5 font-display text-base tracking-[1pt] text-white transition hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cta-strong"
              >
                Leer más
              </a>
            </div>
          </article>
        ))
      }
    </div>
    <p id="post-empty" hidden class="mt-6 text-center text-lg text-on-green">
      No hay artículos en esta categoría todavía.
    </p>
  </section>
</Base>

<style>
  /* Filtro del blog: ocultar cards con !important para ganarle al `display:flex` de la card. */
  .is-hidden {
    display: none !important;
  }
</style>

<script>
  // Filtro por categoría (island mínima, vanilla). Muestra los artículos cuya lista de
  // categorías incluye la seleccionada; "Todos" (data-cat="*") los muestra todos.
  const filterBar = document.getElementById('cat-filter');
  const grid = document.getElementById('post-grid');
  const empty = document.getElementById('post-empty');
  if (filterBar && grid) {
    const pills = Array.from(filterBar.querySelectorAll<HTMLButtonElement>('[data-cat]'));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-cats]'));

    const apply = (cat: string) => {
      let visible = 0;
      cards.forEach((card) => {
        const cats = (card.dataset.cats || '').split('|');
        const show = cat === '*' || cats.includes(cat);
        card.classList.toggle('is-hidden', !show);
        if (show) visible++;
      });
      if (empty) empty.hidden = visible > 0;
      pills.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
    };

    pills.forEach((b) => b.addEventListener('click', () => apply(b.dataset.cat ?? '*')));
  }
</script>
