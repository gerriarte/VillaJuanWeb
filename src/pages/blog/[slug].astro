---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { posts, fmtDate } from '../../lib/blog';
import { wa } from '../../lib/site';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;

// "Seguir leyendo": comparte alguna categoría primero; si no alcanza, se completa.
const shares = (p: (typeof posts)[number]) =>
  p.categories.some((c) => post.categories.includes(c));
const related = [
  ...posts.filter((p) => p.slug !== post.slug && shares(p)),
  ...posts.filter((p) => p.slug !== post.slug && !shares(p)),
].slice(0, 2);
---

<Base
  heroHeader
  title={`${post.title} · Blog Villa Juan`}
  description={post.excerpt}
>
  <article>
    <!-- PORTADA — imagen full-bleed (header flota encima). -->
    <div class="relative">
      <Image
        src={post.image}
        alt={post.imageAlt}
        widths={[768, 1280, 1920]}
        sizes="100vw"
        format="webp"
        quality={74}
        loading="eager"
        fetchpriority="high"
        class="h-[44vh] min-h-[300px] w-full object-cover sm:h-[56vh]"
      />
    </div>

    <!-- HOJA DE LECTURA — superficie blanca que monta sobre la portada. Texto oscuro
         sobre blanco: legibilidad de lectura larga (el verde del fondo no sirve). -->
    <div class="mx-auto max-w-3xl px-4">
      <div class="relative -mt-16 rounded-[2rem] bg-surface p-6 shadow-xl ring-1 ring-black/5 sm:-mt-24 sm:p-10">
        <p class="text-center font-display text-sm tracking-[1pt] text-cta-strong uppercase">
          {post.categories.join(' · ')} · {fmtDate(post.date)}
        </p>
        <h1 class="mt-3 text-center font-display leading-tight text-cta text-[length:clamp(1.75rem,5vw,32pt)]">
          {post.title}
        </h1>

        <div class="mx-auto mt-8 max-w-2xl space-y-5 text-lg leading-relaxed text-ink/85">
          {
            post.body.map((b) =>
              b.type === 'h2' ? (
                <h2 class="mt-8 font-display text-xl tracking-[1pt] text-cta-strong sm:text-2xl">{b.text}</h2>
              ) : b.type === 'ul' ? (
                <ul class="list-disc space-y-1 pl-6 marker:text-cta">
                  {b.items.map((i) => <li>{i}</li>)}
                </ul>
              ) : b.type === 'ol' ? (
                <ol class="list-decimal space-y-2 pl-6 marker:font-semibold marker:text-cta">
                  {b.items.map((i) => <li>{i}</li>)}
                </ol>
              ) : (
                <p>{b.text}</p>
              ),
            )
          }
        </div>

        <!-- CTA de conversión (no apunta a página interna: WhatsApp). -->
        <div class="mt-10 border-t border-line pt-8 text-center">
          <p class="font-display text-xl tracking-[1pt] text-cta-strong">¿Quieres vivirlo en persona?</p>
          <a
            href={wa(`Leí "${post.title}" y quiero planear mi visita a Villa Juan`)}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center justify-center rounded-full bg-cta-strong px-8 py-3 font-display text-lg tracking-[1pt] text-white transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cta-strong"
          >
            Planear mi visita
          </a>
        </div>
      </div>
    </div>

    <!-- SEGUIR LEYENDO -->
    <section class="mx-auto max-w-5xl px-4 pt-16">
      <h2 class="section-title text-center">Seguir leyendo</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          related.map((r) => (
            <a
              href={`/blog/${r.slug}`}
              class="group flex flex-col overflow-hidden rounded-3xl bg-surface shadow-lg ring-1 ring-black/5 transition hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cta-strong"
            >
              <Image
                src={r.image}
                alt={r.imageAlt}
                widths={[320, 480, 640]}
                sizes="(min-width: 640px) 40vw, 90vw"
                format="webp"
                quality={72}
                loading="lazy"
                class="aspect-[16/10] w-full object-cover"
              />
              <div class="flex flex-1 flex-col gap-2 p-5">
                <p class="font-display text-xs tracking-[1pt] text-cta-strong uppercase">{r.categories[0]}</p>
                <h3 class="card-title">{r.title}</h3>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-10 text-center">
        <a
          href="/blog"
          class="inline-flex items-center justify-center rounded-full px-6 py-2.5 font-display text-lg tracking-[1pt] text-ink ring-1 ring-ink/20 transition hover:bg-ink/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
        >
          ← Volver al blog
        </a>
      </div>
    </section>
  </article>
</Base>
