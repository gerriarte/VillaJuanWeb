---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { marked } from 'marked';
import { getPosts, fmtDate, type Post } from '../../lib/blog';
import { assetUrl } from '../../lib/directus';
import { wa } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const shares = (a: Post, b: Post) => a.categories.some((c) => b.categories.includes(c));
  return posts.map((post) => {
    const related = [
      ...posts.filter((p) => p.slug !== post.slug && shares(p, post)),
      ...posts.filter((p) => p.slug !== post.slug && !shares(p, post)),
    ].slice(0, 2);
    return { params: { slug: post.slug }, props: { post, related } };
  });
}

const { post, related } = Astro.props;
const bodyHtml = marked.parse(post.bodyMarkdown);

const siteUrl = Astro.site?.href ?? 'https://villa-juan.com/';
const coverUrl =
  post.image.kind === 'directus'
    ? assetUrl(post.image.id, { width: 1200 })
    : new URL(post.image.asset.src, siteUrl).href;

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  image: coverUrl,
  datePublished: post.date,
  author: { '@type': 'Organization', name: 'Ecogranja Villa Juan', url: siteUrl },
  publisher: {
    '@type': 'Organization',
    name: 'Ecogranja Villa Juan',
    logo: { '@type': 'ImageObject', url: new URL('/og-default.jpg', siteUrl).href },
  },
  mainEntityOfPage: new URL(`/blog/${post.slug}`, siteUrl).href,
  articleSection: post.categories.join(', '),
};
---

<Base
  heroHeader
  ogType="article"
  image={coverUrl}
  title={`${post.title} · Blog Villa Juan`}
  description={post.excerpt}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
  <article>
    <!-- PORTADA — imagen full-bleed (header flota encima). -->
    <div class="relative">
      {
        post.image.kind === 'directus' ? (
          <img
            src={assetUrl(post.image.id, { width: 1600, quality: 74 })}
            alt={post.image.alt}
            fetchpriority="high"
            class="h-[44vh] min-h-[300px] w-full object-cover sm:h-[56vh]"
          />
        ) : (
          <Image
            src={post.image.asset}
            alt={post.image.alt}
            widths={[768, 1280, 1920]}
            sizes="100vw"
            format="webp"
            quality={74}
            loading="eager"
            fetchpriority="high"
            class="h-[44vh] min-h-[300px] w-full object-cover sm:h-[56vh]"
          />
        )
      }
    </div>

    <!-- HOJA DE LECTURA — superficie blanca que monta sobre la portada. Texto oscuro
         sobre blanco: legibilidad de lectura larga (el verde del fondo no sirve). -->
    <div class="mx-auto max-w-3xl px-4">
      <div class="relative -mt-16 rounded-[2rem] bg-surface p-6 shadow-xl ring-1 ring-black/5 sm:-mt-24 sm:p-10">
        <p class="text-center font-display text-sm tracking-[1pt] text-cta-strong uppercase">
          {post.categories.join(' · ')} · {fmtDate(post.date)}
        </p>
        <h1 class="mt-3 text-center font-display leading-tight text-cta text-[length:clamp(1.75rem,5vw,32pt)]">
          {post.title}
        </h1>

        <div class="post-body mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-ink/85" set:html={bodyHtml} />

        <!-- CTA de conversión (no apunta a página interna: WhatsApp). -->
        <div class="mt-10 border-t border-line pt-8 text-center">
          <p class="font-display text-xl tracking-[1pt] text-cta-strong">¿Quieres vivirlo en persona?</p>
          <a
            href={wa(`Leí "${post.title}" y quiero planear mi visita a Villa Juan`)}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center justify-center rounded-full bg-cta-strong px-8 py-3 font-display text-2xl tracking-[1pt] text-white transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cta-strong"
          >
            Planear mi visita
          </a>
        </div>
      </div>
    </div>

    <!-- SEGUIR LEYENDO -->
    <section class="mx-auto max-w-5xl px-4 pt-16">
      <h2 class="section-title text-center">Seguir leyendo</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          related.map((r) => (
            <a
              href={`/blog/${r.slug}`}
              class="group flex flex-col overflow-hidden rounded-3xl bg-surface shadow-lg ring-1 ring-black/5 transition hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cta-strong"
            >
              {r.image.kind === 'directus' ? (
                <img
                  src={assetUrl(r.image.id, { width: 640 })}
                  alt={r.image.alt}
                  loading="lazy"
                  class="aspect-[16/10] w-full object-cover"
                />
              ) : (
                <Image
                  src={r.image.asset}
                  alt={r.image.alt}
                  widths={[320, 480, 640]}
                  sizes="(min-width: 640px) 40vw, 90vw"
                  format="webp"
                  quality={72}
                  loading="lazy"
                  class="aspect-[16/10] w-full object-cover"
                />
              )}
              <div class="flex flex-1 flex-col gap-2 p-5">
                <p class="font-display text-xs tracking-[1pt] text-cta-strong uppercase">{r.categories[0]}</p>
                <h3 class="card-title">{r.title}</h3>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-10 text-center">
        <a
          href="/blog"
          class="inline-flex items-center justify-center rounded-full px-6 py-2.5 font-display text-lg tracking-[1pt] text-on-green ring-1 ring-white/50 transition hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          ← Volver al blog
        </a>
      </div>
    </section>
  </article>
</Base>
