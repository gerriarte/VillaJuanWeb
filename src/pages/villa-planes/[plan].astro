---
/**
 * Página de un Villa Plan: su PDF embebido dentro del sitio (header + footer del layout).
 * Los botones de Villa Planes y de la home apuntan acá, NO al archivo suelto.
 */
import Base from '../../layouts/Base.astro';
import PdfViewer from '../../components/sections/PdfViewer.astro';
import { getPlanes } from '../../lib/planes';
import { planGradient } from '../../lib/pdfs';

// Una página por plan CON PDF (planes y PDFs editables en Directus: colección `planes`).
export async function getStaticPaths() {
  const conPdf = (await getPlanes()).filter((p) => p.pdf && p.href);
  return conPdf.map((plan) => ({
    params: { plan: plan.slug },
    props: { plan, others: conPdf.filter((p) => p.slug !== plan.slug) },
  }));
}

const { plan, others } = Astro.props;
---

<Base
  title={`Villa Plan ${plan.name} · Pasadías en Tenjo | Ecogranja Villa Juan`}
  description={plan.description}
>
  <PdfViewer
    title={`Villa Plan ${plan.name}`}
    file={plan.pdf!.url}
    filename={plan.pdf!.filename}
    description={plan.description}
    backHref="/villa-planes"
    backLabel="Villa Planes"
    waText={plan.waText}
    ctaLabel="Cotizar este plan"
  >
    <!-- Los otros planes: se comparan sin volver atrás. -->
    <div class="mt-14">
      <h2 class="text-center font-bold text-on-green">Mira también los otros Villa Planes</h2>
      <ul class="mx-auto mt-5 flex max-w-xl flex-col items-stretch gap-3 sm:flex-row sm:justify-center">
        {
          others.map((o) => (
            <li class="sm:flex-1">
              <a
                href={o.href}
                aria-label={`Ver el Villa Plan ${o.name}`}
                style={`background-image:${planGradient(o.color)};`}
                class="flex h-full w-full items-center justify-center rounded-full px-6 py-3 font-display text-3xl text-white shadow-lg ring-1 ring-black/10 transition [text-shadow:0_1px_3px_rgba(0,0,0,0.45)] hover:brightness-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              >
                {o.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </PdfViewer>
</Base>
