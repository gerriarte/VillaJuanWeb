---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/sections/ServiceCard.astro';
import { Image } from 'astro:assets';
import { wa } from '../lib/site';
import bannerColegios from '../assets/images/colegios/Banner_Colegios.jpg';
import badgeColegios from '../assets/images/colegios/Colegios.webp';
import { img } from '../lib/images';
import { getCards, type Card } from '../lib/content';
import { assetUrl } from '../lib/directus';

// Semilla local (fallback). En Directus: colección `cards`, section=colegios-talleres.
const seed: Card[] = [
  { title: 'Granjeritos por un Día', imageRight: false,
    image: { kind: 'local', asset: img('Granjeritos_por_un_dia')!, alt: 'Granjeritos por un Día' },
    body: 'Una aventura para que los más pequeños descubran los secretos de la naturaleza y el respeto ambiental. Con retos, observación de fauna y expediciones, los niños despiertan su curiosidad y se convierten en guardianes del ecosistema. La experiencia perfecta para fomentar el liderazgo, el trabajo en equipo y el amor por la vida rural en un entorno seguro y emocionante.' },
  { title: 'Exploradores por un Día', imageRight: false,
    image: { kind: 'local', asset: img('Exploradores_por_un_dia')!, alt: 'Exploradores por un Día' },
    body: 'Expediciones por la granja donde niños y jóvenes exploran, observan y aprenden. A través de divertidos retos y observación de fauna, despiertan su curiosidad y desarrollan el trabajo en equipo, el liderazgo y el amor por la vida rural en un entorno seguro.' },
  { title: 'Agricultor por un Día', imageRight: false,
    image: { kind: 'local', asset: img('Agricultor_por_un_dia')!, alt: 'Agricultor por un Día' },
    body: 'Vive la experiencia de cultivar la tierra y descubre el origen de tus alimentos. Niños y adultos siembran, cosechan y conocen los ciclos naturales de nuestra huerta orgánica. La oportunidad perfecta para valorar el trabajo del campo y conectar con la alimentación saludable bajo el sol de Tenjo.' },
  { title: 'Ecologistas por un Día', imageRight: false,
    image: { kind: 'local', asset: img('Ecologista_por_un_dia')!, alt: 'Ecologistas por un Día' },
    body: 'Los estudiantes se convierten en guardianes del medio ambiente descubriendo acciones concretas para proteger los recursos naturales: reciclaje, conservación, biodiversidad y prácticas sostenibles que pueden aplicar en su vida cotidiana. Un taller que inspira una nueva generación comprometida con el planeta.' },
];
const talleres = await getCards('colegios-talleres', seed);
---

<Base
  heroHeader
  title="Colegios · Salidas pedagógicas en Villa Juan | Tenjo"
  description="Salidas pedagógicas para colegios en Ecogranja Villa Juan: talleres donde los estudiantes aprenden haciendo, explorando y conectándose con la naturaleza en Tenjo."
>
  <!-- HERO — banner full-bleed (header flota encima con degradé). -->
  <section class="relative">
    <Image
      src={bannerColegios}
      alt="Estudiantes conociendo de cerca una llama en la Ecogranja Villa Juan"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      format="webp"
      quality={72}
      loading="eager"
      fetchpriority="high"
      class="h-screen w-full object-cover"
    />
  </section>

  <!-- INTRO — título de sección + dos párrafos. Texto oscuro (ink): blanco falla AA
       sobre el verde lima del fondo (invariante #2). -->
  <section class="mx-auto max-w-4xl px-4 py-16 text-center">
    <h1 class="title-outline font-display leading-[1.05] text-[length:clamp(2.25rem,7vw,48pt)]">
      Salidas pedagógicas
      <span class="block leading-tight text-[length:clamp(1.875rem,5.8vw,40pt)]">para colegios en Villa Juan</span>
    </h1>
    <div class="mx-auto mt-8 max-w-3xl space-y-4 text-lg leading-relaxed text-ink/90">
      <p>
        Transformamos el aprendizaje en una experiencia inolvidable. En la Ecogranja Villa Juan, los
        estudiantes aprenden haciendo, explorando y conectándose con la naturaleza a través de
        talleres diseñados para complementar los procesos educativos de manera práctica, divertida y
        significativa.
      </p>
      <p>
        Nuestros programas permiten que niños y jóvenes desarrollen habilidades ambientales,
        científicas, sociales y emocionales mientras viven una jornada llena de descubrimientos en un
        entorno seguro y rodeado de naturaleza.
      </p>
    </div>
  </section>

  <!-- TALLERES — cards horizontales (imagen izq. + texto der. + CTA). -->
  <section class="mx-auto max-w-5xl px-4 pb-8">
    <h2 class="sr-only">Talleres pedagógicos</h2>
    <div class="space-y-6">
      {
        talleres.map((t) => (
          <ServiceCard
            title={t.title}
            body={t.body}
            image={t.image.kind === 'local' ? t.image.asset : undefined}
            imageUrl={t.image.kind === 'directus' ? assetUrl(t.image.id, { width: 760 }) : undefined}
            imageAlt={t.image.alt}
            square
            ctaLabel="Saber más"
            ctaHref={wa(`Quiero información del taller "${t.title}" para mi colegio`)}
          />
        ))
      }
    </div>
  </section>

  <!-- CTA FINAL — badge ilustrado "Solicitar servicios para colegios". -->
  <section class="px-4 pt-6 pb-8 text-center">
    <a
      href={wa('Quiero planear mi visita Villa Juan')}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Solicitar servicios para colegios"
      class="inline-block transition-transform hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
    >
      <Image
        src={badgeColegios}
        alt="Solicitar servicios para colegios"
        widths={[384, 640, 1024]}
        sizes="(min-width: 640px) 30rem, 90vw"
        format="webp"
        quality={80}
        loading="lazy"
        class="mx-auto w-72 [filter:drop-shadow(0_8px_16px_rgba(0,0,0,0.3))] sm:w-[30rem]"
      />
    </a>
  </section>
</Base>
