---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SiteBackground from '../components/layout/SiteBackground.astro';
import LeafRain from '../components/layout/LeafRain.astro';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';
import { contact, visit, social } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Ruta (relativa al site) de la imagen de compartir (og:image). */
  image?: string;
  /** 'website' | 'article' — para Open Graph. */
  ogType?: string;
  /** true = header transparente flotando sobre un hero full-bleed (home). */
  heroHeader?: boolean;
}

const {
  title = 'Ecogranja Villa Juan · Experiencias y eventos en Tenjo',
  description = 'Ecogranja de experiencias y eventos en Tenjo, Cundinamarca. Celebraciones, empresas, colegios, villa planes y gastronomía rodeados de naturaleza.',
  image = '/og-default.jpg',
  ogType = 'website',
  heroHeader = false,
} = Astro.props;

const siteUrl = Astro.site?.href ?? 'https://www.villa-juan.com/';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;

// JSON-LD del negocio (global en todas las páginas) → SEO local + AEO.
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'TouristAttraction'],
  name: 'Ecogranja Villa Juan',
  description:
    'Ecogranja de experiencias y eventos en Tenjo, Cundinamarca, a 30 minutos de Bogotá. Pasadías, celebraciones, eventos corporativos, salidas pedagógicas y gastronomía al barril.',
  url: siteUrl,
  telephone: contact.phone.replace(/\s/g, ''),
  email: contact.email,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: visit.address,
    addressLocality: 'Tenjo',
    addressRegion: 'Cundinamarca',
    addressCountry: 'CO',
  },
  hasMap: visit.maps,
  areaServed: { '@type': 'City', name: 'Bogotá' },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday', 'Sunday'], opens: '09:30', closes: '18:00' },
  ],
  sameAs: [social.facebook, social.instagram, social.tiktok, social.linkedin].filter(Boolean),
  priceRange: '$$',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (previews en WhatsApp, Facebook, LinkedIn…) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Ecogranja Villa Juan" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Datos estructurados del negocio -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />

    <Font cssVariable="--font-sunrise" preload />

    <!-- Reveal por scroll: marca <html> ANTES del paint para ocultar el estado inicial
         sin FOUC. Si el JS está apagado, la clase no se pone → las imágenes se ven normales. -->
    <script is:inline>
      document.documentElement.classList.add('reveal-on');
    </script>
    <!-- TODO(post-scaffold): <ClientRouter /> para View Transitions. Recordar re-init de
         ScrollTrigger en astro:page-load cuando entre GSAP. -->
  </head>
  <body class="flex min-h-screen flex-col">
    <SiteBackground />
    <LeafRain />
    <Header overlay={heroHeader} />
    <!-- pb: reserva aire sobre el footer para que el caballo reclinado (que asoma ~50%
         sobre la separación) no tape el contenido de la última sección. -->
    <main class="flex-1 pb-28 sm:pb-40 md:pb-56">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />

    <script>
      // Reveal por scroll de las imágenes (todo el sitio). IntersectionObserver liviano.
      // Respeta reduce-motion. Excluye hero/LCP (eager) y zonas con animación propia (.no-reveal).
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = Array.from(
        document.querySelectorAll<HTMLElement>('main img:not([loading="eager"]):not(.no-reveal)'),
      );
      if (reduce || !('IntersectionObserver' in window)) {
        // Sin animación: mostrar todo (defensivo, por si el CSS ya ocultó).
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                obs.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.06 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
