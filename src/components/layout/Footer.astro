const socials = [
  { label: 'Facebook', href: social.facebook, icon: icons.facebook },
  { label: 'Instagram', href: social.instagram, icon: icons.instagram },
  { label: 'TikTok', href: social.tiktok, icon: icons.tiktok },
  { label: 'LinkedIn', href: social.linkedin || '#', icon: icons.linkedin }, // TODO: URL real
  { label: 'WhatsApp', href: contact.whatsapp, icon: icons.whatsapp },
];
---

<footer class="relative isolate text-white">
  <!-- Tira de hojas: DETRÁS del fondo naranja. Va antes que la capa de fondo (mismo -z-10)
       para que el naranja la tape donde se solapan; solo asoma por encima de la división de
       color. `isolate` mantiene el -z-10 dentro del footer. -->
  <LeafDivider class="absolute inset-x-0 bottom-full -z-10 translate-y-[30%]" />

  <!-- Fondo naranja como capa propia (antes iba en el <footer>): encima de las hojas,
       debajo del contenido y del caballo. -->
  <div class="scene-orange absolute inset-0 -z-10" aria-hidden="true"></div>

  <!-- Don Juan reclinado: descansa sobre el borde superior del footer y asoma hacia arriba.
       Decorativo (aria-hidden), no interactivo. -->
  <AlphaImage
    src={horseFooter}
    alt=""
    ariaHidden
    widths={[480, 736, 1000]}
    sizes="(min-width: 768px) 46rem, 92vw"
    loading="lazy"
    class="pointer-events-none absolute bottom-full left-1/2 w-[22rem] max-w-[92vw] -translate-x-1/2 translate-y-[50%] [filter:drop-shadow(0_10px_16px_rgba(0,0,0,0.35))] sm:w-[34rem] md:w-[46rem]"
  />

  <!-- El orden del DOM es el de MOBILE (menú + logo en la misma fila, luego redes y
       contacto a lo ancho). Desktop no depende de ese orden: cada bloque declara su
       celda con col-start/row-start, así que la grilla de 3 columnas queda igual que
       siempre (menú | redes al pie | logo sobre contacto). -->
  <div
    class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-10 px-4 pt-32 pb-12 sm:pt-44 md:grid-cols-3 md:gap-x-10 md:gap-y-4 md:pt-60"
  >
    <!-- Menú en texto corrido blanco (font-body), a juego con el bloque de contacto.
         El text-shadow hace de scrim sobre el naranja. -->
    <nav aria-label="Navegación del pie" class="md:col-start-1 md:row-span-2 md:row-start-1">
      <ul
        class="flex flex-col gap-2 font-body text-lg font-semibold text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.4)] sm:text-xl"
      >
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="transition hover:text-accent">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Logo: comparte fila con el menú en mobile, centrado contra la lista.
         En desktop vuelve arriba a la derecha, sobre el contacto. -->
    <div class="flex items-center justify-end md:col-start-3 md:row-start-1 md:items-start">
      <img
        src={logoVillaJuan.src}
        alt="Ecogranja Villa Juan"
        width={logoVillaJuan.width}
        height={logoVillaJuan.height}
        class="h-auto w-32 [filter:drop-shadow(0_2px_6px_rgba(0,0,0,0.3))] sm:w-44 md:w-56"
      />
    </div>

    <!-- Redes sociales: a lo ancho bajo el menú en mobile; en desktop, columna del
         medio alineada a la base. -->
    <div
      class="col-span-2 flex flex-col items-center justify-end md:col-span-1 md:col-start-2 md:row-span-2 md:row-start-1"
    >
      <ul class="flex flex-wrap items-center justify-center gap-4">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white ring-1 ring-white/25 transition hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-5 w-5">
                  <path d={s.icon} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Solo ciudad, teléfono y correo (la dirección detallada vive en la página de
         contacto). Dos puntos más que el resto y en bold: es la info de conversión.
         A lo ancho en mobile: el correo no entra en media columna. -->
    <address
      class="col-span-2 flex flex-col gap-1.5 text-base font-bold text-white not-italic [text-shadow:0_1px_3px_rgba(0,0,0,0.4)] md:col-span-1 md:col-start-3 md:row-start-2 md:items-end md:text-right"
    >
      <span>{visit.city}</span>
      <a href={contact.phoneHref} class="transition-colors hover:text-accent">
        {contact.phone}
      </a>
      <a href={`mailto:${contact.email}`} class="transition-colors hover:text-accent">
        {contact.email}
      </a>
    </address>
  </div>

  <!-- Subfooter: verde plano de marca. NO `.scene-green` (arranca en lima #99c43d y el
       blanco falla AA); `brand-strong` da 5:1 con blanco puro (invariante #2). -->
  <div class="bg-brand-strong">
    <p class="mx-auto max-w-6xl px-4 py-4 text-center text-xs text-white">
      © {year} Villa Juan Ecogranja. Todos los derechos reservados. · Diseño y desarrollo: MTM
      Marca tu Marca
    </p>
  </div>
</footer>
