---
import { footerNav as nav, contact, social, visit } from '../../lib/site';

// Año fijo: Date.now() no está disponible en este entorno de build.
const year = 2026;

const socials = [
  { label: 'Instagram', href: social.instagram },
  { label: 'Facebook', href: social.facebook },
  { label: 'TikTok', href: social.tiktok },
];
---

<footer class="scene-dark text-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1">
      <p class="font-display text-3xl leading-none">Villa Juan</p>
      <p class="mt-3 max-w-xs text-sm text-white/80">
        Ecogranja de experiencias y eventos rodeada de naturaleza, en Tenjo, Cundinamarca.
      </p>
      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-white/90 transition-colors hover:text-white"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-label="Navegación del pie">
      <p class="mb-3 text-xs font-semibold tracking-wide text-white/60 uppercase">Explorar</p>
      <ul class="flex flex-col gap-2 text-sm">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-white/90 transition-colors hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="mb-3 text-xs font-semibold tracking-wide text-white/60 uppercase">Contacto</p>
      <address class="flex flex-col gap-2 text-sm not-italic text-white/90">
        <a href={`mailto:${contact.email}`} class="transition-colors hover:text-white">
          {contact.email}
        </a>
        <a href={contact.phoneHref} class="transition-colors hover:text-white">
          {contact.phone}
        </a>
        <span>{contact.location}</span>
      </address>
    </div>

    <div>
      <p class="mb-3 text-xs font-semibold tracking-wide text-white/60 uppercase">Visítanos</p>
      <div class="flex flex-col gap-2 text-sm text-white/90">
        <span>{visit.hoursLabel}</span>
        <span>{visit.hours}</span>
        <a
          href={visit.maps}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white"
        >
          Cómo llegar →
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-white/15">
    <p class="mx-auto max-w-6xl px-4 py-4 text-center text-xs text-white/70">
      © {year} Villa Juan Ecogranja. Todos los derechos reservados. · Diseño y desarrollo: MTM
      Marca tu Marca
    </p>
  </div>
</footer>
