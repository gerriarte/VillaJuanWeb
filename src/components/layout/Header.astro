---
import { nav } from '../../lib/site';
import { menuPdf } from '../../lib/pdfs';
import logo from '../../assets/images/home/Logo-villajuan-blanco.svg';

interface Props {
  /**
   * true = header transparente encima del hero (degradé verde→transparente).
   * En ambos modos el header queda SIEMPRE a la vista al hacer scroll:
   * overlay → `fixed` (flota sobre el hero full-bleed), resto → `sticky`.
   */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string): boolean =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header
  class:list={[
    'site-header w-full',
    overlay ? 'fixed inset-x-0 top-0 z-50' : 'sticky top-0 z-50 bg-brand-strong',
  ]}
>
  <div
    class="header-bg"
    style={overlay
      ? 'background:linear-gradient(to bottom,#00560fF2 0%,#0a7d2a99 45%,transparent 100%);'
      : undefined}
  >
    <div class="relative mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4">
      <a href="/" class="shrink-0" aria-label="Ecogranja Villa Juan · Inicio">
        <img src={logo.src} alt="Ecogranja Villa Juan" width="174" height="96" class="h-auto w-36 sm:w-44" />
      </a>

      <nav aria-label="Navegación principal" class="flex items-center">
        <!-- Menú móvil y tablet (<lg): disclosure nativo <details>, cero JS. Se cierra solo al navegar (MPA). -->
        <details class="mobile-nav relative lg:hidden">
          <summary
            class="flex cursor-pointer list-none items-center rounded-lg p-1 text-[#FFF200] [text-shadow:0_1px_3px_rgba(0,0,0,0.4)] transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
            aria-label="Abrir menú de navegación"
          >
            <svg class="i-menu h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <line x1="3" y1="7" x2="21" y2="7" />
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="17" x2="21" y2="17" />
            </svg>
            <svg class="i-close h-9 w-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <line x1="5" y1="5" x2="19" y2="19" />
              <line x1="19" y1="5" x2="5" y2="19" />
            </svg>
          </summary>

          <!-- 6 ítems + CTA: el alto se limita al hueco real bajo el header (no 80dvh a ciegas)
               y la lista scrollea si el teléfono es muy bajo. -->
          <ul class="absolute right-0 top-full z-50 mt-3 flex max-h-[calc(100dvh-9rem)] min-w-60 flex-col gap-0.5 overflow-y-auto overscroll-contain rounded-2xl bg-brand-strong p-3 font-display text-[21pt] text-[#FFF200] shadow-xl ring-1 ring-black/10 sm:text-[23pt]">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={[
                      'block rounded-xl px-3 py-1.5 transition hover:bg-white/10',
                      isActive(item.href) && 'underline underline-offset-4',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }

            <!-- CTA diferenciada: naranja sólido, cierra el bloque de navegación. -->
            <li class="mt-1.5 border-t border-white/25 pt-2.5">
              <a
                href={menuPdf.href}
                aria-current={isActive(menuPdf.href) ? 'page' : undefined}
                class="block rounded-xl bg-cta-strong px-3 py-1.5 text-center text-white transition hover:bg-cta focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              >
                Ver Menú
              </a>
            </li>
          </ul>
        </details>

        <!-- Menú desktop (≥lg): barra horizontal plana. A <lg no entran los 6 ítems + CTA. -->
        <ul class="hidden items-center gap-x-4 gap-y-1 font-display text-[21pt] text-[#FFF200] [text-shadow:0_1px_3px_rgba(0,0,0,0.4)] lg:flex xl:gap-x-5 xl:text-[23pt]">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'transition hover:text-white',
                    isActive(item.href) && 'underline underline-offset-4',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }

          <!-- CTA diferenciada: naranja sólido, último ítem del nav. -->
          <li class="[text-shadow:none]">
            <a
              href={menuPdf.href}
              aria-current={isActive(menuPdf.href) ? 'page' : undefined}
              class="inline-flex items-center rounded-full bg-cta-strong px-5 py-1.5 text-[20pt] leading-tight text-white shadow-md transition hover:bg-cta focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
            >
              Ver Menú
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  /* ── Header pegado al viewport ────────────────────────────────────────────
     El fondo verde sólido NO se pinta cambiando `background-image` (no es
     animable): va en un ::before que sube de opacidad al hacer scroll, encima
     del degradé del hero. El JS solo agrega/quita `.is-stuck`. */
  .header-bg {
    position: relative;
  }
  .header-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-brand-strong);
    opacity: 0;
    pointer-events: none;
  }
  .site-header.is-stuck .header-bg::before {
    opacity: 1;
  }
  .site-header.is-stuck .header-bg {
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.28);
  }
  @media (prefers-reduced-motion: no-preference) {
    .header-bg::before {
      transition: opacity 0.35s ease;
    }
    .header-bg {
      transition: box-shadow 0.35s ease;
    }
  }

  /* <details> como menú móvil: sin marcador nativo y swap de icono según estado. */
  .mobile-nav > summary {
    list-style: none;
  }
  .mobile-nav > summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav > summary .i-close {
    display: none;
  }
  .mobile-nav[open] > summary .i-menu {
    display: none;
  }
  .mobile-nav[open] > summary .i-close {
    display: block;
  }
</style>

<script>
  // Fondo verde sólido del header al hacer scroll. Listener pasivo con un
  // `classList.toggle` idempotente: si el estado no cambia el navegador no
  // recalcula estilos, así que no hace falta rAF ni throttle. Sin JS el header
  // igual queda fijo: solo no cambia de fondo (degradación aceptable).
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const sync = () => header.classList.toggle('is-stuck', window.scrollY > 24);
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }

  // Progressive enhancement: cierra el menú móvil (<details>) al tocar fuera o con Escape.
  // Sin esto el menú igual funciona (se cierra con la ✕ o al navegar).
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) menu.open = false;
    });
  }
</script>
