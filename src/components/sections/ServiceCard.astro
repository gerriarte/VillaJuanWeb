---
/**
 * ServiceCard — card de servicio/vertical (ej. "XV Años y Grados" en Celebraciones).
 *
 * Diseño fuente: grupo "Articulo 1" del .fig (absoluto, 1341x418, desktop).
 * Acá se RE-AUTORIZA semántico + mobile-first, no se copia el layout absoluto.
 *
 * Invariantes aplicados:
 *  #1 mobile-first: apila en móvil (flex-col) → fila en desktop (md:flex-row).
 *  #2 WCAG AA: botón usa bg-cta-strong (#c0360d, 5.5:1 con blanco), no #e15329 (3.8:1).
 *  #3 semántico: <article>/<h3>/<p>/<a>, cero posición absoluta como layout.
 *  #4 cero JS.
 *  #5 imágenes: <Image> de astro:assets (AVIF/WebP, responsive, lazy).
 *  #7 estilo solo vía tokens (text-cta, bg-cta-strong, font-display, surface…).
 *
 * Tipografía: título en Sunrise vía .card-title (canónico, 28pt + interletrado
 * para legibilidad); label del CTA en font-display.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { img } from '../../lib/images';

interface Props {
  title: string;
  body: string;
  ctaLabel?: string;
  ctaHref?: string;
  image?: ImageMetadata;
  /** Nombre del archivo en src/assets/images (drop-and-go). Se resuelve con img(). */
  imageName?: string;
  imageAlt?: string;
  /** Título como <h2> en vez de <h3> cuando la card no vive bajo un heading de sección. */
  headingLevel?: 'h2' | 'h3';
  /** En desktop coloca la imagen a la derecha (layout alternado del diseño). */
  reverse?: boolean;
  /** Recorta la imagen 1:1 (aspect-square) en vez del 5:3 por defecto. */
  square?: boolean;
}

const {
  title,
  body,
  ctaLabel = 'Reservar',
  // TODO: destino real = formulario de cotización por vertical / WhatsApp, NO página interna.
  ctaHref = '#cotizar',
  image,
  imageName,
  imageAlt = '',
  headingLevel = 'h3',
  reverse = false,
  square = false,
} = Astro.props;

const resolved = image ?? (imageName ? img(imageName) : undefined);

const Heading = headingLevel;
---

<article
  class:list={[
    'flex flex-col gap-5 rounded-3xl bg-surface p-4 shadow-sm ring-1 ring-black/5',
    'sm:p-5 md:flex-row md:items-center md:gap-8 md:rounded-[2.5rem] md:p-6',
    reverse && 'md:flex-row-reverse',
  ]}
>
  <div class="md:w-2/5 md:shrink-0">
    {
      resolved ? (
        <Image
          src={resolved}
          alt={imageAlt}
          widths={[320, 480, 640]}
          sizes="(min-width: 768px) 40vw, 100vw"
          loading="lazy"
          decoding="async"
          class:list={[square ? 'aspect-square' : 'aspect-[5/3]', 'w-full rounded-2xl object-cover']}
        />
      ) : (
        <div
          class:list={[square ? 'aspect-square' : 'aspect-[5/3]', 'w-full rounded-2xl bg-line']}
          role="img"
          aria-label={imageAlt || 'Imagen del servicio'}
        />
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-3 md:gap-4">
    <Heading class="card-title">
      {title}
    </Heading>
    <p class="text-base leading-relaxed text-ink md:text-lg">
      {body}
    </p>
    <div class="mt-1">
      <a
        href={ctaHref}
        class="inline-flex items-center justify-center rounded-full bg-cta-strong px-6 py-3 font-display text-lg text-white transition hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cta-strong"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</article>
