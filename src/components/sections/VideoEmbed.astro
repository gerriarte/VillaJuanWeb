---
/**
 * VideoEmbed — video de una sección, editable desde el CMS (colección `videos`).
 *
 * · YouTube → FACHADA (patrón lite-embed): por defecto NO se carga nada de YouTube,
 *   solo la portada y un botón de play. El <iframe> del player se inserta recién al
 *   hacer clic, así la página no arrastra el ~1 MB de JS del player ni pega requests
 *   a Google antes de que el usuario los pida (invariantes #4 y #6).
 *   Dominio: youtube-nocookie.com (sin cookies de tracking hasta la reproducción).
 * · Archivo subido → <video> nativo con preload="none" (no baja nada hasta el play).
 *
 * Portada: la del CMS; si no hay, la miniatura de YouTube (o el primer frame del archivo).
 */
import CmsImage from '../ui/CmsImage.astro';
import type { Video } from '../../lib/content';
import { assetUrl } from '../../lib/directus';

interface Props {
  video: Video;
}

const { video } = Astro.props;
const { title, youtubeId, fileUrl, poster } = video;
const posterSrc =
  poster?.kind === 'directus' ? assetUrl(poster.id, { width: 1280 }) : poster?.asset.src;
const ytThumb = youtubeId ? `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg` : undefined;
const frame =
  'relative aspect-video w-full overflow-hidden rounded-3xl bg-black shadow-2xl ring-4 ring-white/30';
---

{
  !youtubeId && fileUrl ? (
    <div class={frame}>
      <video
        src={fileUrl}
        poster={posterSrc}
        controls
        preload="none"
        playsinline
        title={title}
        class="no-reveal h-full w-full object-cover"
      />
    </div>
  ) : (
<div
  class="yt-facade relative aspect-video w-full overflow-hidden rounded-3xl bg-black shadow-2xl ring-4 ring-white/30"
  data-yt={youtubeId}
  data-yt-title={title}
>
  <button
    type="button"
    class="group absolute inset-0 block h-full w-full cursor-pointer focus-visible:outline-4 focus-visible:-outline-offset-4 focus-visible:outline-white"
    aria-label={`Reproducir video: ${title}`}
  >
    <!-- no-reveal: el poster no entra en el reveal por scroll (se movería dentro
         del marco recortado). El play sí tiene su micro-interacción en hover. -->
    {
      poster ? (
        <CmsImage
          image={{ ...poster, alt: '' }}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 56rem, 100vw"
          class="no-reveal h-full w-full object-cover"
        />
      ) : (
        <img src={ytThumb} alt="" width="480" height="360" loading="lazy" class="no-reveal h-full w-full object-cover" />
      )
    }
    <span
      class="pointer-events-none absolute inset-0 bg-black/25 transition group-hover:bg-black/10"
      aria-hidden="true"></span>
    <span
      class="pointer-events-none absolute top-1/2 left-1/2 flex h-20 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-cta-strong/95 shadow-xl ring-4 ring-white/70 transition duration-300 group-hover:scale-110 sm:h-24 sm:w-24"
      aria-hidden="true"
    >
      <svg class="ml-1 h-9 w-9 sm:h-11 sm:w-11" viewBox="0 0 24 24" fill="#ffffff" aria-hidden="true">
        <path d="M8 5v14l11-7z"></path>
      </svg>
    </span>
  </button>
</div>
  )
}

<script>
  // Al primer clic se reemplaza la fachada por el player real (autoplay, porque
  // el clic ya fue la intención del usuario). `once`: después no hay más JS vivo.
  for (const box of document.querySelectorAll<HTMLElement>('.yt-facade[data-yt]')) {
    box.querySelector('button')?.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
        iframe.title = box.dataset.ytTitle ?? 'Video';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.className = 'absolute inset-0 h-full w-full';
        box.replaceChildren(iframe);
      },
      { once: true },
    );
  }
</script>
