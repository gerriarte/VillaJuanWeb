---
/**
 * MapEmbed — ubicación de la finca con FACHADA (mismo patrón que VideoEmbed).
 *
 * Por defecto NO se carga nada de Google: solo un mapa estático local (optimizado por
 * astro:assets) y, al hacer clic, se inserta el iframe interactivo de Google Maps.
 * Un iframe de Maps pesa ~1 MB de JS de terceros y deja cookies apenas entra en pantalla;
 * la fachada lo evita (invariante #4: cero JS por defecto, y no romper el LCP).
 *
 * Sin JS la sección sigue completa: el póster es un enlace a Google Maps y los botones
 * de "Cómo llegar" / WhatsApp están siempre visibles.
 *
 * El póster se generó con tiles de OpenStreetMap (atribución impresa en la imagen).
 */
import { Image } from 'astro:assets';
import { visit, contact } from '../../lib/site';
import mapaPoster from '../../assets/images/home/mapa-villa-juan.jpg';

const { lat, lng } = visit.coords;

// Embed sin API key. `output=embed` es la forma pública del mapa incrustado.
const embedSrc = `https://www.google.com/maps?q=${lat},${lng}&z=16&hl=es&output=embed`;
// "Cómo llegar": abre la app de mapas con la ruta ya trazada al destino.
const directions = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;

const pill =
  'inline-flex items-center justify-center gap-2 rounded-full px-7 py-3 font-display text-xl transition focus-visible:outline-2 focus-visible:outline-offset-2';
---

<section class="mx-auto max-w-5xl px-4 py-16">
  <h2 class="section-title text-center">Cómo llegar</h2>
  <p class="mx-auto mt-3 max-w-2xl text-center leading-relaxed">
    {visit.address} · {visit.city}. {visit.note}.
  </p>
  <p class="mt-1 text-center text-sm text-ink/70">
    {visit.hoursLabel}, {visit.hours}
  </p>

  <div
    class="map-facade relative mt-8 aspect-[4/3] w-full overflow-hidden rounded-3xl shadow-xl ring-1 ring-line sm:aspect-[16/9]"
    data-map-src={embedSrc}
  >
    <a
      href={visit.maps}
      target="_blank"
      rel="noopener noreferrer"
      class="group absolute inset-0 block focus-visible:outline-4 focus-visible:-outline-offset-4 focus-visible:outline-cta-strong"
      aria-label="Abrir la ubicación de Ecogranja Villa Juan en Google Maps"
    >
      <Image
        src={mapaPoster}
        alt="Mapa de la ubicación de Ecogranja Villa Juan en la Vereda Guangatá, Tenjo"
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 64rem, 100vw"
        format="webp"
        quality={80}
        loading="lazy"
        class="no-reveal h-full w-full object-cover"
      />
      <span
        class="absolute inset-x-0 bottom-0 flex justify-center bg-gradient-to-t from-black/70 to-transparent p-4 sm:p-6"
      >
        <span
          class={`${pill} bg-cta-strong text-white shadow-lg ring-1 ring-white/30 group-hover:brightness-110`}
        >
          Ver el mapa interactivo
        </span>
      </span>
    </a>
  </div>

  <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
    {/* Contraste (invariante #2): estos botones van sobre el verde de la página, donde
        `text-cta-strong` suelto da 2.2:1 y falla AA. El naranja solo se usa como FONDO
        (blanco encima = 5.5:1) o sobre `surface` blanco (5.6:1), igual que en PdfViewer. */}
    <a
      href={directions}
      target="_blank"
      rel="noopener noreferrer"
      class={`${pill} bg-cta-strong text-white shadow-lg outline-cta-strong hover:brightness-110`}
    >
      Cómo llegar
    </a>
    <a
      href={contact.whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class={`${pill} bg-surface text-cta-strong shadow-lg outline-cta-strong hover:brightness-95`}
    >
      Escríbenos por WhatsApp
    </a>
  </div>
</section>

<script>
  // Al primer clic la fachada se reemplaza por el mapa real. `once` implícito: después
  // del reemplazo el enlace ya no existe, así que no queda JS vivo.
  for (const box of document.querySelectorAll<HTMLElement>('.map-facade[data-map-src]')) {
    box.querySelector('a')?.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = box.dataset.mapSrc!;
      iframe.title = 'Mapa de Ecogranja Villa Juan';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      box.replaceChildren(iframe);
    });
  }
</script>
