---
/**
 * MapEmbed — ubicación de la finca, con FACHADA (mismo patrón que VideoEmbed).
 *
 * Por defecto NO se carga nada de Google: solo un mapa estático local (optimizado por
 * astro:assets) y, al hacer clic, se inserta el iframe interactivo de Google Maps.
 * Un iframe de Maps pesa ~1 MB de JS de terceros y deja cookies apenas entra en pantalla;
 * la fachada lo evita (invariante #4: cero JS por defecto, y no romper el LCP).
 *
 * LAYOUT: es un PANEL, no una sección. Vive en la columna izquierda del FAQ, debajo de
 * las preguntas, y en desktop CRECE (`flex-1`) hasta emparejar la altura del formulario
 * del costado, que es más alto. Así las dos columnas cierran juntas en vez de dejar el
 * hueco de ~470 px que quedaba bajo las preguntas. En mobile no hay nada que emparejar:
 * vuelve a una relación de aspecto fija.
 *
 * Los botones van FUERA de la tarjeta a propósito: al hacer clic, el iframe reemplaza el
 * contenido de la tarjeta, y si vivieran dentro desaparecerían con el swap.
 *
 * Sin JS la sección sigue completa: el póster es un enlace a Google Maps.
 *
 * El póster se generó con tiles de OpenStreetMap (atribución impresa en la imagen).
 */
import { Image } from 'astro:assets';
import { visit, contact } from '../../lib/site';
import mapaPoster from '../../assets/images/home/mapa-villa-juan.jpg';

const { lat, lng } = visit.coords;

// Embed sin API key. `output=embed` es la forma pública del mapa incrustado.
const embedSrc = `https://www.google.com/maps?q=${lat},${lng}&z=16&hl=es&output=embed`;
// "Cómo llegar": abre la app de mapas con la ruta ya trazada al destino.
const directions = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;

// Contraste (invariante #2): estos botones van sobre el verde de la página, donde
// `text-cta-strong` suelto da 2.2:1 y falla AA. El naranja solo se usa como FONDO
// (blanco encima = 5.5:1) o sobre `surface` blanco (5.6:1), igual que en PdfViewer.
const pill =
  'inline-flex flex-1 items-center justify-center rounded-full px-5 py-3 text-center font-display text-lg shadow-lg transition focus-visible:outline-2 focus-visible:outline-offset-2 sm:text-xl';
---

<div class="flex flex-col gap-3 md:min-h-0 md:flex-1">
  <p class="text-sm leading-snug text-ink/80">
    <span class="font-bold">{visit.address}</span> · {visit.city}. {visit.note}.<br />
    {visit.hoursLabel}, {visit.hours}
  </p>

  <div
    class="map-facade relative aspect-[4/3] overflow-hidden rounded-2xl shadow-lg ring-1 ring-black/5 md:aspect-auto md:min-h-56 md:flex-1"
    data-map-src={embedSrc}
  >
    <a
      href={visit.maps}
      target="_blank"
      rel="noopener noreferrer"
      class="group absolute inset-0 block focus-visible:outline-4 focus-visible:-outline-offset-4 focus-visible:outline-cta-strong"
      aria-label="Abrir la ubicación de Ecogranja Villa Juan en Google Maps"
    >
      <Image
        src={mapaPoster}
        alt="Mapa de la ubicación de Ecogranja Villa Juan en la Vereda Guangatá, Tenjo"
        widths={[640, 960, 1280]}
        sizes="(min-width: 768px) 34rem, 100vw"
        format="webp"
        quality={80}
        loading="lazy"
        class="no-reveal h-full w-full object-cover"
      />
      <span
        class="absolute inset-x-0 bottom-0 flex justify-center bg-gradient-to-t from-black/70 to-transparent p-4"
      >
        <span
          class="inline-flex items-center justify-center rounded-full bg-cta-strong px-6 py-2.5 font-display text-lg text-white shadow-lg ring-1 ring-white/30 transition group-hover:brightness-110"
        >
          Ver el mapa interactivo
        </span>
      </span>
    </a>
  </div>

  <div class="flex flex-wrap gap-3">
    <a
      href={directions}
      target="_blank"
      rel="noopener noreferrer"
      class={`${pill} bg-cta-strong text-white outline-cta-strong hover:brightness-110`}
    >
      Cómo llegar
    </a>
    <a
      href={contact.whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class={`${pill} bg-surface text-cta-strong outline-cta-strong hover:brightness-95`}
    >
      Escríbenos por WhatsApp
    </a>
  </div>
</div>

<script>
  // Al primer clic la fachada se reemplaza por el mapa real. No hace falta `once`: tras el
  // reemplazo el enlace ya no existe, así que no queda JS vivo.
  for (const box of document.querySelectorAll<HTMLElement>('.map-facade[data-map-src]')) {
    box.querySelector('a')?.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = box.dataset.mapSrc!;
      iframe.title = 'Mapa de Ecogranja Villa Juan';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      box.replaceChildren(iframe);
    });
  }
</script>
