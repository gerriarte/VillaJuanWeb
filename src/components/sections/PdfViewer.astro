---
/**
 * PdfViewer — muestra un PDF EMBEBIDO dentro del sitio (el layout aporta header y footer,
 * así el visitante vuelve y sigue navegando normal, sin quedar atrapado en el visor del
 * navegador).
 *
 * Cero JS (invariante #4): es un <object> nativo. Los navegadores que no embeben PDF
 * (mayoría de móviles) renderizan el contenido de reserva que va DENTRO del <object>,
 * con el botón para abrirlo en pestaña nueva. Los botones de abajo están siempre visibles,
 * por si el visor embebido carga pero al visitante le queda incómodo.
 */
import { wa } from '../../lib/site';

interface Props {
  title: string;
  /** URL del archivo PDF. */
  file: string;
  /** Nombre de descarga (sin el hash del build). */
  filename: string;
  description?: string;
  /** Volver a la página desde la que se llega. */
  backHref: string;
  backLabel: string;
  /** Mensaje prellenado del CTA de WhatsApp. */
  waText: string;
  /** Texto del CTA de WhatsApp. */
  ctaLabel?: string;
}

const {
  title,
  file,
  filename,
  description,
  backHref,
  backLabel,
  waText,
  ctaLabel = 'Cotizar por WhatsApp',
} = Astro.props;

// #view=FitH → el visor abre ajustado al ancho, sin que el usuario tenga que hacer zoom.
const embedSrc = `${file}#view=FitH`;

const pillBase =
  'inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-center font-bold shadow-lg ring-1 ring-black/10 transition hover:-translate-y-0.5 hover:brightness-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';
---

<section class="mx-auto max-w-5xl px-4 py-10 sm:py-14">
  <a
    href={backHref}
    class="inline-flex items-center gap-2 rounded-full px-1 font-bold text-on-green underline underline-offset-4 transition hover:text-[#FFF200] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
  >
    <span aria-hidden="true">←</span> Volver a {backLabel}
  </a>

  <h1 class="section-title mt-5 text-center">{title}</h1>
  {
    description && (
      <p class="mx-auto mt-4 max-w-2xl text-center leading-relaxed text-on-green">{description}</p>
    )
  }

  <!-- Visor. min-h evita que quede una franja inútil en pantallas bajas. -->
  <div class="mt-8 overflow-hidden rounded-3xl bg-surface shadow-xl ring-1 ring-black/10">
    <object
      data={embedSrc}
      type="application/pdf"
      title={`${title} (PDF)`}
      class="block h-[70svh] min-h-[440px] w-full sm:h-[80svh]"
    >
      <div class="flex flex-col items-center gap-5 px-6 py-14 text-center">
        <p class="max-w-md leading-relaxed text-ink">
          Tu navegador no puede mostrar el PDF aquí mismo. Ábrelo en una pestaña nueva o descárgalo,
          y vuelve cuando quieras: el sitio te espera.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href={file}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[pillBase, 'bg-cta text-white']}
          >
            Abrir el PDF
          </a>
          <a
            href={file}
            download={filename}
            class:list={[pillBase, 'bg-brand-strong text-white']}
          >
            Descargar PDF
          </a>
        </div>
      </div>
    </object>
  </div>

  <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
    <a
      href={file}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[pillBase, 'bg-surface text-cta-strong']}
    >
      Abrir en pestaña nueva
    </a>
    <a href={file} download={filename} class:list={[pillBase, 'bg-surface text-cta-strong']}>
      Descargar PDF
    </a>
    <a
      href={wa(waText)}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[pillBase, 'bg-cta text-white']}
    >
      {ctaLabel}
    </a>
  </div>

  <slot />
</section>
