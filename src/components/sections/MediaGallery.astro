---
/**
 * MediaGallery — video destacado + grid de fotos con lightbox.
 *
 * Progressive enhancement (invariante #4), todo el JS es opcional:
 * · El video es un FACADE: se pinta un póster local y solo al hacer clic se inserta el
 *   iframe de youtube-nocookie. Así la página no carga ~1 MB de JS de YouTube ni deja
 *   cookies de terceros al entrar. Sin JS, el póster es un enlace normal a YouTube.
 * · Cada foto es un <a> a su versión grande: sin JS abre la imagen, con JS abre el
 *   lightbox (<dialog> nativo → Esc, foco y backdrop gratis) con flechas y teclado.
 * · Todas las imágenes son `lazy` y llevan `.no-reveal` porque el reveal global de
 *   Base.astro anima `transform`/`opacity` y competiría con el hover del grid.
 */
import { Image, getImage } from 'astro:assets';

interface Photo {
  img: ImageMetadata;
  alt: string;
}

interface Props {
  photos: Photo[];
  video?: { id: string; title: string; poster: ImageMetadata };
  /** Prefijo de ids: permite más de una galería en la misma página. */
  id?: string;
}

const { photos, video, id = 'galeria' } = Astro.props;

// Versión grande para el lightbox y para el `href` (lo que se abre sin JS).
// Se limita el LADO MAYOR a 1280: fijando solo el ancho, una foto vertical saldría
// 1280×1920 (el doble de píxeles que una horizontal) para verse igual en el visor.
const full = await Promise.all(
  photos.map((p) =>
    getImage({
      src: p.img,
      format: 'webp',
      quality: 78,
      ...(p.img.height > p.img.width ? { height: 1280 } : { width: 1280 }),
    }),
  ),
);
---

<div data-gallery id={id}>
  {
    video && (
      <div
        class="relative mx-auto aspect-video max-w-4xl overflow-hidden rounded-3xl shadow-2xl ring-1 ring-white/20"
        data-video-id={video.id}
        data-video-title={video.title}
      >
        <a
          href={`https://www.youtube.com/watch?v=${video.id}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group absolute inset-0 block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
          aria-label={`Ver en YouTube: ${video.title}`}
        >
          <Image
            src={video.poster}
            alt=""
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 56rem, 92vw"
            format="webp"
            quality={78}
            loading="lazy"
            class="no-reveal h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
          />
          {/* Velo + botón de play: el póster es una foto del taller, no un frame del video. */}
          <span class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></span>
          <span
            aria-hidden="true"
            class="absolute top-1/2 left-1/2 flex h-20 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-cta-strong/95 shadow-xl ring-4 ring-white/70 transition group-hover:scale-110 sm:h-24 sm:w-24"
          >
            <svg viewBox="0 0 24 24" class="ml-1 h-9 w-9 fill-white sm:h-11 sm:w-11">
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </span>
          <span
            class="absolute inset-x-0 bottom-0 p-4 text-center font-display text-xl leading-tight text-white [text-shadow:0_2px_4px_rgba(0,0,0,0.6)] sm:p-6 sm:text-2xl"
          >
            {video.title}
          </span>
        </a>
      </div>
    )
  }

  <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
    {
      photos.map((p, i) => (
        <li>
          <a
            href={full[i].src}
            data-lightbox={i}
            aria-label={`Ampliar: ${p.alt}`}
            class="group block overflow-hidden rounded-2xl ring-1 ring-white/20 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
          >
            <Image
              src={p.img}
              alt={p.alt}
              widths={[240, 360, 520]}
              sizes="(min-width: 1024px) 16rem, (min-width: 640px) 30vw, 45vw"
              format="webp"
              quality={74}
              loading="lazy"
              class="no-reveal aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105 group-hover:brightness-110"
            />
          </a>
        </li>
      ))
    }
  </ul>

  {/* Lightbox. Vacío hasta que el script lo usa; sin JS nunca se abre. */}
  <dialog
    data-lightbox-dialog
    aria-label="Galería ampliada"
    class="max-h-none max-w-none bg-transparent p-0 backdrop:bg-black/85"
  >
    <div class="relative flex h-[100dvh] w-screen items-center justify-center p-4 sm:p-8">
      <img data-lb-img src="" alt="" class="max-h-full max-w-full rounded-xl object-contain shadow-2xl" />

      <button
        type="button"
        data-lb-close
        aria-label="Cerrar galería"
        class="absolute top-3 right-3 flex h-12 w-12 items-center justify-center rounded-full bg-black/60 text-3xl leading-none text-white transition hover:bg-black/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:top-5 sm:right-5"
      >
        <span aria-hidden="true">×</span>
      </button>
      <button
        type="button"
        data-lb-prev
        aria-label="Foto anterior"
        class="absolute top-1/2 left-2 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white transition hover:bg-black/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:left-5"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-7 w-7 fill-current"
          ><path d="M15.4 7.4 14 6l-6 6 6 6 1.4-1.4L10.8 12z"></path></svg
        >
      </button>
      <button
        type="button"
        data-lb-next
        aria-label="Foto siguiente"
        class="absolute top-1/2 right-2 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white transition hover:bg-black/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:right-5"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-7 w-7 fill-current"
          ><path d="M8.6 16.6 10 18l6-6-6-6-1.4 1.4L13.2 12z"></path></svg
        >
      </button>

      <p
        data-lb-caption
        class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-4 text-center text-sm text-white [text-shadow:none] sm:text-base"
      >
      </p>
    </div>
  </dialog>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    // --- Video: el facade se sustituye por el iframe al primer clic ---
    const box = root.querySelector<HTMLElement>('[data-video-id]');
    const link = box?.querySelector('a');
    link?.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      // youtube-nocookie: sin cookies de tracking hasta que el usuario decide ver.
      iframe.src = `https://www.youtube-nocookie.com/embed/${box!.dataset.videoId}?autoplay=1&rel=0`;
      iframe.title = box!.dataset.videoTitle ?? 'Video';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      box!.replaceChildren(iframe);
    });

    // --- Lightbox ---
    const dlg = root.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]'));
    const img = dlg?.querySelector<HTMLImageElement>('[data-lb-img]');
    const caption = dlg?.querySelector<HTMLElement>('[data-lb-caption]');
    if (!dlg || !img || !links.length) continue;

    let i = 0;
    const show = (n: number) => {
      i = (n + links.length) % links.length;
      const a = links[i];
      const thumb = a.querySelector('img');
      img.src = a.href;
      img.alt = thumb?.alt ?? '';
      if (caption) caption.textContent = `${thumb?.alt ?? ''} · ${i + 1} de ${links.length}`;
      // Precarga SOLO la siguiente: adelantarse a las dos vecinas triplicaba los datos
      // de abrir una foto, y el avance natural de la galería es hacia adelante.
      const next = links[(i + 1) % links.length];
      if (next) new Image().src = next.href;
    };

    links.forEach((a, n) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        show(n);
        dlg.showModal();
      }),
    );

    dlg.querySelector('[data-lb-close]')?.addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(i - 1));
    dlg.querySelector('[data-lb-next]')?.addEventListener('click', () => show(i + 1));
    // Clic en el fondo (no en la imagen ni en los botones) cierra.
    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dlg || t.hasAttribute('data-lb-caption') || t.tagName === 'DIV') dlg.close();
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(i + 1);
      else if (e.key === 'ArrowLeft') show(i - 1);
    });
  }
</script>
