# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Fuentes de diseño pesadas — NO se versionan (mockups + Figma).
# El .ttf (src/assets/fonts) y los PNG/JPG de assets SÍ se versionan.
*.jpg
*.jpeg
# …pero los assets del sitio SÍ (ya optimizados; las páginas los importan).
!src/assets/images/**/*.jpg
!src/assets/images/**/*.jpeg
!public/og-default.jpg
*.fig
mock_web/
design/VillaJuan.fig

# Volcados de assets fuente en public/ (dumps de Drive) — no van al repo
public/Hero/
public/HOME-*/

# Fuentes de diseño pesadas del home (SVG-wrappers con raster embebido, ~155MB).
# Se rasterizan/optimizan a PNG/WebP versionados en src/assets/images/home/.
design/home-sources/

# Originales sin optimizar del carrusel (~194MB). Las versiones optimizadas viven en
# src/assets/images/home/carrusel/ y son las que importan las páginas.
src/assets/images/home/Carrusel_home/

# Originales del Taller de Liderazgo con Caballos (51 fotos, ~329MB) + su zip de Drive.
# La selección optimizada vive en src/assets/images/empresas/coaching/ y es la que
# importa la página. Regenerable con design/optimize-coaching-photos.mjs.
src/assets/images/empresas/Fotos Taller Liderazgo con Caballos-*/
src/assets/images/empresas/Fotos Taller Liderazgo con Caballos-*.zip

# Modelos 3D fuente (~20MB c/u) y artefactos del pipeline offline de design/3d/.
# El sitio NO sirve el .glb: sirve el sprite sheet ya optimizado de public/3d/.
# Los scripts del pipeline (render/sprite/verify) SÍ se versionan.
design/3d/*.glb
design/3d/frames/
design/3d/verify/
design/3d/out/
design/3d/node_modules/
